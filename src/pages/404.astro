---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={`Page not found | ${site.name}`} description="This page doesn't exist. See the work or get in touch." noindex>
  <div class="wrap notfound">
    <h1>This page doesn’t exist.</h1>
    <p>It may have moved, or the link was mistyped.</p>
    <div class="notfound__actions">
      <a class="btn btn--primary" href="/#work">See the work</a>
      <a class="btn btn--secondary" href="/#contact">Get in touch</a>
    </div>
  </div>
</Base>

<style>
  .notfound { display: grid; gap: var(--space-l); padding-block: var(--space-2xl); }
  h1 { max-width: 14ch; }
  p { font-size: var(--step-1); color: var(--text-muted); }
  .notfound__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); }
</style>
