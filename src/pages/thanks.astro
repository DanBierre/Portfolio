---
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import { site } from '../site.config';
---

<Base title={`Brief sent | ${site.name}`} description="Your brief has been sent.">
  <meta slot="head" name="robots" content="noindex" />
  <div class="wrap thanks">
    <h1>Brief sent.</h1>
    <p>Thanks, I’ll reply within 1 working day. Or book a call now if it’s urgent.</p>
    <div class="thanks__actions">
      <BookCall variant="primary" />
      <a class="btn btn--secondary" href="/">Back to the homepage</a>
    </div>
  </div>
</Base>

<style>
  .thanks { display: grid; gap: var(--space-l); padding-block: var(--space-2xl); }
  p { font-size: var(--step-1); color: var(--text-muted); }
  .thanks__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); }
</style>
