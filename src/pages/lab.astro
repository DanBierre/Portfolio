---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import { site } from '../site.config';

const items = (await getCollection('lab')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={`Lab | ${site.name}`}
  description="Self-initiated experiments in generative image, video and interaction: the ideas that become client work."
>
  <div class="wrap lab">
    <header class="lab__header">
      <h1>Lab</h1>
      <p class="lab__intro">Self-initiated experiments. Where new techniques get tested before they reach client work.</p>
    </header>

    <div class="lab__grid">
      {
        items.map((item) => (
          <article class="lab__item">
            <Picture
              src={item.data.image}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 64em) 45vw, 100vw"
              alt={item.data.imageAlt}
            />
            <div class="lab__meta">
              <h2>{item.data.title}</h2>
              {item.data.interactive && <span class="lab__badge">Interactive</span>}
            </div>
            <p>{item.data.summary}</p>
            {item.data.link && (
              <a href={item.data.link}>
                {item.data.interactive ? 'Try it' : 'View'}
                <span class="visually-hidden">: {item.data.title}</span>
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div class="lab__cta">
      <p>Want one of these ideas in your next pitch?</p>
      <BookCall variant="primary" />
    </div>
  </div>
</Base>

<style>
  .lab { padding-block: var(--space-xl) 0; }
  .lab__header { display: grid; gap: var(--space-m); margin-bottom: var(--space-xl); }
  .lab__intro { font-size: var(--step-1); color: var(--text-muted); max-width: 40ch; }
  .lab__grid { display: grid; gap: var(--space-xl) var(--space-l); }
  .lab__item { display: grid; gap: var(--space-s); align-content: start; }
  .lab__item :global(img) { aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; margin-bottom: var(--space-xs); }
  .lab__meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-s); }
  h2 { font-size: var(--step-2); letter-spacing: -0.03em; }
  .lab__badge {
    padding: 0.15em 0.6em;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--accent);
  }
  .lab__item p { color: var(--text-muted); }
  .lab__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }
  .lab__cta p { font-size: var(--step-1); }

  @media (min-width: 64em) {
    .lab__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
