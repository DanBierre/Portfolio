---
import { Picture, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, next } = Astro.props;
const { title, clientType, role, timeline, outcome, results, cover, coverAlt, quote, beforeAfter } = entry.data;
const { Content } = await render(entry);
const og = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<Base title={`${title} | ${site.name}`} description={`${outcome} ${clientType}.`} ogImage={og.src}>
  <article class="case">
    <header class="wrap case__header">
      <h1>{title}</h1>
      <dl class="case__meta">
        <div><dt>Client</dt><dd>{clientType}</dd></div>
        <div><dt>Role</dt><dd>{role}</dd></div>
        <div><dt>Timeline</dt><dd>{timeline}</dd></div>
      </dl>
      <p class="case__outcome">{outcome}</p>
    </header>

    <div class="wrap">
      <Picture
        src={cover}
        alt={coverAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 90rem) 85rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="case__cover"
        style={`view-transition-name: work-${entry.id}`}
      />
    </div>

    <div class="wrap case__body">
      <div class="prose"><Content /></div>

      {beforeAfter && <BeforeAfter {...beforeAfter} />}

      <section class="prose" aria-labelledby="results-title">
        <h2 id="results-title">Results</h2>
        <ul>{results.map((r) => <li>{r}</li>)}</ul>
      </section>

      {
        quote && (
          <blockquote class="case__quote">
            <p>“{quote.text}”</p>
            <footer>{quote.who}</footer>
          </blockquote>
        )
      }
    </div>

    <section id="case-cta" class="wrap case__cta" aria-labelledby="case-cta-title" data-slug={entry.id}>
      <h2 id="case-cta-title">Have a similar project? Let's talk</h2>
      <div class="case__cta-actions">
        <BookCall variant="primary" />
        <a class="btn btn--secondary" href="/#contact">Send a brief</a>
      </div>
    </section>

    <nav class="wrap case__next" aria-label="More work">
      <a href={`/work/${next.id}`}>
        <span><span class="muted">Next case study:</span> {next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>

<script>
  const cta = document.getElementById('case-cta');
  if (cta) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        (window as any).umami?.track('case_study_completed', { slug: cta.dataset.slug });
        io.disconnect();
      }
    });
    io.observe(cta);
  }
</script>

<style>
  .case__header { display: grid; gap: var(--space-l); padding-block: var(--space-xl) var(--space-l); }
  h1 { font-size: var(--step-5); max-width: 18ch; overflow-wrap: anywhere; }
  .case__meta { display: flex; flex-wrap: wrap; gap: var(--space-m) var(--space-xl); }
  .case__meta dt { font-size: var(--step--1); color: var(--text-muted); }
  .case__meta dd { margin: 0; }
  .case__outcome { font-size: var(--step-2); letter-spacing: -0.025em; line-height: 1.25; max-width: 30ch; }
  .wrap :global(.case__cover) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 4px; }

  .case__body { display: grid; gap: var(--space-xl); padding-block: var(--space-xl); }
  .prose { display: grid; gap: var(--space-m); max-width: var(--measure); }
  .prose :global(h2) { font-size: var(--step-3); margin-top: var(--space-l); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(ul) { padding-left: 1.2em; display: grid; gap: var(--space-xs); }
  .prose :global(img) { border-radius: 4px; }

  .case__quote { border-top: 1px solid var(--text); padding-top: var(--space-m); max-width: 40ch; }
  .case__quote p { font-size: var(--step-2); letter-spacing: -0.025em; line-height: 1.3; }
  .case__quote footer { margin-top: var(--space-s); color: var(--text-muted); }

  .case__cta { display: grid; gap: var(--space-l); padding-block: var(--space-xl); border-top: 1px solid var(--border); }
  .case__cta h2 { max-width: 14ch; }
  .case__cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-s); }

  .case__next { padding-top: var(--space-l); }
  .case__next a {
    display: block;
    overflow-wrap: anywhere;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-decoration: none;
  }
  .case__next a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
</style>
