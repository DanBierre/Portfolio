---
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import { warp, speed, CLIPS } from '../../lib/indie-edit';
import { site } from '../../site.config';

// Same functions the homepage edit runs on: the curve here is the curve there.
const RAMP = 0.8;
const curve = (fn: (p: number) => number) =>
  Array.from({ length: 51 }, (_, i) => i / 50)
    .map((p, i) => `${i ? 'L' : 'M'}${(p * 100).toFixed(1)} ${(100 - fn(p) * 100).toFixed(1)}`)
    .join(' ');
---

<Base
  title={`Time Warp | ${site.name}`}
  description="Drag a speed ramp and watch the footage rush, hang in slow motion and rush out: the time warp from the homepage edit, opened up."
>
  <div class="wrap warp-page">
    <header class="warp-page__head">
      <a class="label" href="/lab">← Lab</a>
      <h1>Time Warp</h1>
      <p class="warp-page__intro">
        The speed ramp behind the homepage edit, opened up. Drag the ramp and the footage rushes in, hangs in slow motion
        and rushes out. The curve is the code: one sine term bent into straight time.
      </p>
    </header>

    <div class="warp-page__stage">
      <figure class="warp-page__screen">
        <video
          data-video
          src={`/media/japan/${CLIPS[0]}.mp4`}
          muted
          playsinline
          preload="none"
          aria-label="Japan footage playing at the ramped speed"></video>
        <p class="warp-page__hud label" aria-hidden="true">×<span data-rate>1.00</span></p>
        <p class="warp-page__missing" data-missing hidden>Footage isn't in this build; the curve still runs.</p>
      </figure>

      <svg class="warp-page__plot" viewBox="-6 -6 112 112" role="img" aria-labelledby="plot-title">
        <title id="plot-title">Footage time against real time: a straight line bent by the ramp, with playback speed dashed</title>
        <path class="grid" d="M0 0H100V100H0Z M50 0V100 M0 50H100"></path>
        <path class="diag" d="M0 100L100 0"></path>
        <path class="speed" data-speed d={curve((p) => speed(p, RAMP) / 2)}></path>
        <path class="warp" data-curve d={curve((p) => warp(p, RAMP))}></path>
        <line class="head" data-head x1="0" x2="0" y1="0" y2="100"></line>
        <circle class="dot" data-dot cx="0" cy="100" r="2"></circle>
      </svg>
    </div>

    <form class="warp-page__controls" data-controls>
      <noscript><p>The playground needs JavaScript.</p></noscript>
      <fieldset class="clips">
        <legend class="label">Clip</legend>
        {
          CLIPS.map((c, i) => (
            <label class="clip">
              <input type="radio" name="clip" value={c} checked={i === 0} />
              <span>{c}</span>
            </label>
          ))
        }
      </fieldset>
      <div class="field">
        <label for="ramp">Ramp</label>
        <input id="ramp" name="ramp" type="range" min="0" max="1" step="0.01" value={RAMP} />
      </div>
      <div class="field">
        <label for="length">Shot length (s)</label>
        <input id="length" name="length" type="range" min="0.6" max="2.8" step="0.1" value="1.6" />
      </div>
      <button class="btn btn--primary" type="button" data-play>Play</button>
    </form>

    <pre class="warp-page__code" aria-label="The warp function"><code><span class="k">const</span> k = <span class="n" data-k>{(0.95 * RAMP).toFixed(2)}</span>; <span class="c">// 0.95 × ramp: below 1, so time never runs backwards</span>
<span class="k">const</span> <span class="f">warp</span> = (p) =&gt; p + k * Math.sin(2 * Math.PI * p) / (2 * Math.PI);
<span class="k">const</span> <span class="f">speed</span> = (p) =&gt; 1 + k * Math.cos(2 * Math.PI * p); <span class="c">// → video.playbackRate</span></code></pre>

    <section class="warp-page__cta">
      <p>Edits like this, cut to your brand.</p>
      <BookCall variant="primary" />
    </section>
  </div>
</Base>

<script>
  import { warp, speed } from '../../lib/indie-edit';

  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const video = $<HTMLVideoElement>('[data-video]');
  const form = $<HTMLFormElement>('[data-controls]');
  const play = $<HTMLButtonElement>('[data-play]');
  const [curveEl, speedEl, head, dot] = ['[data-curve]', '[data-speed]', '[data-head]', '[data-dot]'].map((s) => $<SVGElement>(s));
  const out = { rate: $<HTMLElement>('[data-rate]'), k: $<HTMLElement>('[data-k]') };
  const ramp = () => Number(form.ramp.value);
  const length = () => Number(form.length.value);

  const path = (fn: (p: number) => number) =>
    Array.from({ length: 51 }, (_, i) => i / 50)
      .map((p, i) => `${i ? 'L' : 'M'}${(p * 100).toFixed(1)} ${(100 - fn(p) * 100).toFixed(1)}`)
      .join(' ');
  const redraw = () => {
    curveEl.setAttribute('d', path((p) => warp(p, ramp())));
    speedEl.setAttribute('d', path((p) => speed(p, ramp()) / 2));
    out.k.textContent = (0.95 * ramp()).toFixed(2);
  };
  form.addEventListener('input', (e) => {
    if ((e.target as HTMLInputElement).name === 'clip') {
      video.src = `/media/japan/${form.clip.value}.mp4`;
      if (running) video.play().catch(() => {});
    } else redraw();
  });

  // One shot on loop: footage rate follows the ramp, the playhead rides the curve.
  let running = false;
  let t = 0;
  let last = 0;
  const tick = (now: number) => {
    if (!running) return;
    t += last ? Math.min(0.1, (now - last) / 1000) : 0;
    last = now;
    if (t >= length()) {
      t = 0;
      video.currentTime = 0;
    }
    const p = t / length();
    const rate = Math.min(2.5, Math.max(0.25, speed(p, ramp())));
    video.playbackRate = rate;
    video.style.setProperty('--blur', String(Math.max(0, rate - 1)));
    head.setAttribute('x1', String(p * 100));
    head.setAttribute('x2', String(p * 100));
    dot.setAttribute('cx', String(p * 100));
    dot.setAttribute('cy', String(100 - warp(p, ramp()) * 100));
    out.rate.textContent = rate.toFixed(2);
    requestAnimationFrame(tick);
  };
  const setRunning = (on: boolean) => {
    running = on;
    play.textContent = on ? 'Pause' : 'Play';
    if (on) {
      last = 0;
      video.play().catch(() => {});
      requestAnimationFrame(tick);
    } else video.pause();
  };
  play.addEventListener('click', () => setRunning(!running));
  video.addEventListener('error', () => ($<HTMLElement>('[data-missing]').hidden = false));

  // Motion welcome: start by itself once idle and on screen. Reduced motion: wait for Play.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const begin = () =>
      new IntersectionObserver(([e]) => setRunning(e.isIntersecting)).observe(video);
    'requestIdleCallback' in window ? requestIdleCallback(begin, { timeout: 2000 }) : setTimeout(begin, 1200);
  }
</script>

<style>
  .warp-page { padding-block: var(--space-xl); }
  .warp-page__head { display: grid; gap: var(--space-m); margin-bottom: var(--space-xl); }
  .warp-page__head a { text-decoration: none; }
  .warp-page__intro { font-size: var(--step-1); color: var(--text-muted); max-width: 48ch; }

  .warp-page__stage {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-m);
    align-items: center;
  }
  .warp-page__screen { position: relative; margin: 0; aspect-ratio: 16 / 9; background: #141414; overflow: hidden; }
  .warp-page__screen video {
    --blur: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Fast stretches smear, like the shader's motion blur on the homepage. */
    filter: blur(calc(var(--blur) * 2.5px)) contrast(1.05);
  }
  .warp-page__hud {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    margin: 0;
    padding: 0.2em 0.6em;
    background: rgb(20 20 20 / 0.7);
    color: #ecebe7; /* always light: it sits on the footage */
    font-family: var(--font-data);
    font-variant-numeric: tabular-nums;
  }
  .warp-page__missing { position: absolute; inset: auto var(--space-s) var(--space-s); margin: 0; color: #ecebe7; font-size: var(--step--1); }

  .warp-page__plot { width: 100%; height: auto; overflow: visible; }
  .warp-page__plot path,
  .warp-page__plot line { fill: none; vector-effect: non-scaling-stroke; }
  .warp-page__plot .grid { stroke: var(--border); stroke-width: 1; }
  .warp-page__plot .diag { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 2 4; opacity: 0.5; }
  .warp-page__plot .speed { stroke: var(--rust); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .warp-page__plot .warp { stroke: var(--gold); stroke-width: 2.5; }
  .warp-page__plot .head { stroke: var(--text); stroke-width: 1; opacity: 0.5; }
  .warp-page__plot .dot { fill: var(--gold); }

  .warp-page__controls {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: var(--space-m);
    align-items: end;
    margin-top: var(--space-l);
  }
  .clips { display: flex; flex-wrap: wrap; gap: 0.4rem; border: 0; padding: 0; margin: 0; }
  .clips legend { margin-bottom: 0.4rem; }
  .clip { position: relative; }
  .clip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .clip span {
    display: inline-block;
    padding: 0.45em 0.9em;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-data);
    font-size: var(--step--1);
  }
  .clip input:checked + span { border-color: var(--gold); color: var(--gold); }
  .clip input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }
  .field { display: grid; gap: 0.35rem; }
  .field label { font-size: var(--step--1); font-weight: 500; }
  .field input { width: 100%; accent-color: var(--gold); min-height: 2.75rem; }

  .warp-page__code {
    margin-top: var(--space-l);
    padding: var(--space-m);
    border: 1px solid var(--border);
    overflow-x: auto;
    font: 400 var(--step--1) / 1.7 var(--font-data);
  }
  .warp-page__code .k { color: var(--rust); }
  .warp-page__code .f { color: var(--text); }
  .warp-page__code .n { color: var(--gold); }
  .warp-page__code .c { color: var(--text-muted); }

  .warp-page__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); margin-top: var(--space-xl); }
  .warp-page__cta p { font-size: var(--step-2); margin: 0; }

  @media (max-width: 47.99em) {
    .warp-page__stage,
    .warp-page__controls { grid-template-columns: 1fr; }
  }
</style>
