---
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import { segments, actions, applyActions, runtime } from '../../data/lab/rough-cut';
import { site } from '../../site.config';

// Without JavaScript the page shows the finished cut.
const done = applyActions(segments, actions);
const total = runtime(segments, done.order);
const stateOf = (id: string) => (done.dropped.has(id) ? 'dropped' : done.order.includes(id) ? 'selected' : 'idle');
const byId = Object.fromEntries(segments.map((s) => [s.id, s]));
const fmt = (n: number) => `${n.toFixed(1)} s`;
---

<Base
  title={`AI Rough Cut | ${site.name}`}
  description="An agent reads the transcript and footage, then proposes an edit: selects, order and timings, ready for an editor to refine."
>
  <div class="wrap rc">
    <header class="rc__head">
      <a class="label" href="/lab">← Lab</a>
      <h1>AI Rough Cut</h1>
      <p class="rc__intro">
        An agent reads a transcript, picks the selects, cuts the dead air and proposes an order, leaving notes like an
        assistant editor would. The editor stays in charge; the agent does the first pass.
      </p>
      <p class="label rc__demo"><span class="rc__tag">demo data</span> Footage coming: the transcript is illustrative.</p>
    </header>

    <div class="rc__controls" data-rc-controls hidden>
      <button class="btn btn--primary" type="button" data-play>Play</button>
      <button class="btn btn--secondary" type="button" data-step>Step</button>
      <button class="btn btn--secondary" type="button" data-reset>Reset</button>
      <span class="label rc__progress num" data-progress>0 / {actions.length}</span>
    </div>
    <noscript><p class="rc__nojs">The agent replay needs JavaScript. Here is the finished rough cut.</p></noscript>

    <div class="rc__grid">
      <section aria-labelledby="rc-transcript">
        <h2 id="rc-transcript" class="rc__h">Transcript</h2>
        <ol class="rc__transcript" data-transcript>
          {
            segments.map((s) => (
              <li data-id={s.id} data-state={stateOf(s.id)}>
                <span class="num rc__tc">{fmt(s.start)}</span>
                <span class="rc__line">{s.text}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="rc__side" aria-labelledby="rc-timeline">
        <h2 id="rc-timeline" class="rc__h">Timeline</h2>
        <div class="rc__track" data-track>
          {
            done.order.map((id) => (
              <span class="rc__clip" style={`flex-grow: ${byId[id].end - byId[id].start}`} data-id={id}>
                {byId[id].src ? <video src={byId[id].src} muted playsinline preload="metadata" /> : id}
              </span>
            ))
          }
        </div>

        <h2 class="rc__h">Agent notes</h2>
        <ol class="rc__log" data-log aria-live="polite">{done.notes.map((n) => <li>{n}</li>)}</ol>

        <h2 class="rc__h">Rough cut <span class="num rc__runtime" data-runtime>{fmt(total)}</span></h2>
        <ol class="rc__cut" data-cut>{done.order.map((id) => <li>{byId[id].text}</li>)}</ol>
      </section>
    </div>

    <aside class="rc__cta">
      <p>Agencies drown in footage. An agent that does the first pass gives editors their day back.</p>
      <BookCall variant="primary" />
    </aside>
  </div>
</Base>

<script>
  import { segments, actions, applyActions, runtime } from '../../data/lab/rough-cut';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const byId = Object.fromEntries(segments.map((s) => [s.id, s]));
  const transcript = document.querySelector<HTMLElement>('[data-transcript]')!;
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const log = document.querySelector<HTMLElement>('[data-log]')!;
  const cut = document.querySelector<HTMLElement>('[data-cut]')!;
  const runtimeEl = document.querySelector<HTMLElement>('[data-runtime]')!;
  const progress = document.querySelector<HTMLElement>('[data-progress]')!;
  const playBtn = document.querySelector<HTMLButtonElement>('[data-play]')!;
  let applied = 0;
  let timer = 0;

  const render = (animateLast = false) => {
    const s = applyActions(segments, actions, applied);
    for (const li of transcript.querySelectorAll<HTMLElement>('li')) {
      const id = li.dataset.id!;
      li.dataset.state = s.dropped.has(id) ? 'dropped' : s.order.includes(id) ? 'selected' : 'idle';
    }
    track.replaceChildren(
      ...s.order.map((id) => {
        const clip = document.createElement('span');
        clip.className = 'rc__clip';
        clip.dataset.id = id;
        clip.style.flexGrow = String(byId[id].end - byId[id].start);
        clip.textContent = id;
        return clip;
      }),
    );
    log.replaceChildren(...s.notes.map((n) => Object.assign(document.createElement('li'), { textContent: n })));
    cut.replaceChildren(...s.order.map((id) => Object.assign(document.createElement('li'), { textContent: byId[id].text })));
    runtimeEl.textContent = `${runtime(segments, s.order).toFixed(1)} s`;
    progress.textContent = `${applied} / ${actions.length}`;
    if (animateLast && !reduce.matches) {
      const last = actions[applied - 1];
      const target = last && 'segment' in last ? track.querySelector<HTMLElement>(`[data-id="${last.segment}"]`) : null;
      target?.animate([{ transform: 'scaleX(0.4)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 350, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
    }
  };

  const stop = () => {
    clearTimeout(timer);
    playBtn.textContent = 'Play';
  };
  const step = () => {
    if (applied >= actions.length) return false;
    applied++;
    render(true);
    return applied < actions.length;
  };
  const loop = () => {
    if (step()) timer = window.setTimeout(loop, 550);
    else stop();
  };

  playBtn.addEventListener('click', () => {
    if (playBtn.textContent === 'Pause') return stop();
    if (applied >= actions.length) applied = 0;
    if (reduce.matches) {
      applied = actions.length;
      render();
      return;
    }
    playBtn.textContent = 'Pause';
    loop();
  });
  document.querySelector('[data-step]')!.addEventListener('click', () => {
    stop();
    step();
  });
  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    stop();
    applied = 0;
    render();
  });

  render();
  document.querySelector<HTMLElement>('[data-rc-controls]')!.hidden = false;
</script>

<style>
  .rc { padding-block: var(--space-xl) 0; }
  .rc__head { display: grid; gap: var(--space-m); margin-bottom: var(--space-l); }
  .rc__head a { text-decoration: none; }
  .rc__intro { font-size: var(--step-1); color: var(--text-muted); max-width: 48ch; }
  .rc__demo { text-transform: none; display: flex; flex-wrap: wrap; gap: 0.6em; align-items: center; }
  .rc__tag { padding: 0.1em 0.6em; border: 1px solid var(--border); border-radius: 999px; color: var(--text); }

  .rc__controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); margin-bottom: var(--space-l); }
  .rc__progress { color: var(--text-muted); margin-left: var(--space-s); }
  .rc__nojs { color: var(--text-muted); margin-bottom: var(--space-l); }

  .rc__grid { display: grid; gap: var(--space-xl); align-items: start; }
  .rc__h { font-size: var(--step-1); font-weight: 500; letter-spacing: -0.02em; margin-block: var(--space-l) var(--space-s); display: flex; gap: var(--space-s); align-items: baseline; }
  .rc__h:first-child { margin-top: 0; }
  .rc__runtime { color: var(--gold); }

  .rc__transcript { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .rc__transcript li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border-left: 2px solid transparent;
    transition: color 0.3s, border-color 0.3s, opacity 0.3s;
  }
  .rc__tc { color: var(--text-muted); font-size: var(--step--1); }
  .rc__transcript li[data-state='selected'] { border-left-color: var(--gold); }
  .rc__transcript li[data-state='selected'] .rc__line { color: var(--gold); }
  .rc__transcript li[data-state='dropped'] { opacity: 0.5; }
  .rc__transcript li[data-state='dropped'] .rc__line { text-decoration: line-through; }

  .rc__track { display: flex; gap: 2px; min-height: 3.5rem; padding: 4px; border: 1px solid var(--border); background: var(--surface); }
  .rc__clip {
    display: grid;
    place-items: center;
    min-width: 0;
    overflow: hidden;
    background: var(--border);
    color: var(--text);
    font-family: var(--font-data);
    font-size: var(--step--1);
    transform-origin: left;
  }
  .rc__clip video { width: 100%; height: 100%; object-fit: cover; }
  .rc__log { margin: 0; padding-left: 1.2em; color: var(--text-muted); display: grid; gap: 4px; min-height: 2em; }
  .rc__cut { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; }

  .rc__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }
  .rc__cta p { font-size: var(--step-1); max-width: 48ch; }

  @media (prefers-reduced-motion: reduce) {
    .rc__transcript li { transition: none; }
  }
  @media (min-width: 64em) {
    .rc__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  }
</style>
