---
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import { kanji } from '../../data/lab/kanji';
import { site } from '../../site.config';

const first = kanji[0];
const join = (xs: string[]) => (xs.length ? xs.join('、') : '—');
---

<Base
  title={`Kanji Develops | ${site.name}`}
  description="Kanji resolve out of noise, the same diffusion reveal as the site's headline, as a JLPT N2 study toy."
>
  <div class="wrap kanji-page">
    <header class="kanji-page__head">
      <a class="label" href="/lab">← Lab</a>
      <h1>Kanji Develops</h1>
      <p class="kanji-page__intro">
        Each kanji resolves out of noise, the same diffusion reveal as this site's headline, then gives up its meaning
        and readings. Thirty N2-level kanji (approximate), for study.
      </p>
    </header>

    <div class="kanji-page__stage" data-kanji-app>
      <p class="kanji-page__count num" data-kanji-count aria-live="polite">01 / {kanji.length}</p>
      <p id="kanji-char" class="kanji-page__char" lang="ja">{first.char}</p>
      <dl class="kanji-page__meta" data-kanji-meta aria-live="polite">
        <div><dt>meaning</dt><dd id="kanji-meaning">{first.meanings.join(', ')}</dd></div>
        <div><dt>on</dt><dd id="kanji-on" lang="ja">{join(first.on)}</dd></div>
        <div><dt>kun</dt><dd id="kanji-kun" lang="ja">{join(first.kun)}</dd></div>
      </dl>

      <div class="kanji-page__controls" data-kanji-controls hidden>
        <button class="btn btn--secondary" type="button" data-prev>Previous</button>
        <button class="btn btn--primary" type="button" data-next>Next</button>
        <button class="btn btn--secondary" type="button" data-reveal hidden>Reveal</button>
        <button class="btn btn--secondary" type="button" data-shuffle>Shuffle</button>
        <label class="kanji-page__quiz"><input type="checkbox" data-quiz /> Quiz mode</label>
        <p class="label kanji-page__keys">← → to move<span data-quiz-hint hidden> · Space to reveal</span></p>
      </div>

      <svg class="kanji-page__filters" width="0" height="0" aria-hidden="true" focusable="false">
        <filter id="kanji-develop" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
        </filter>
      </svg>
    </div>

    <noscript>
      <p class="kanji-page__nojs">The study toy needs JavaScript. Here is the whole deck:</p>
      <table class="kanji-page__table">
        <thead><tr><th>Kanji</th><th>Meaning</th><th>On</th><th>Kun</th></tr></thead>
        <tbody>
          {
            kanji.map((k) => (
              <tr>
                <td lang="ja">{k.char}</td>
                <td>{k.meanings.join(', ')}</td>
                <td lang="ja">{join(k.on)}</td>
                <td lang="ja">{join(k.kun)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </noscript>

    <aside class="kanji-page__cta">
      <p>The same reveal can launch a product, a title sequence or a campaign site.</p>
      <BookCall variant="primary" />
    </aside>
  </div>
</Base>

<script>
  import { kanji } from '../../data/lab/kanji';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const app = document.querySelector<HTMLElement>('[data-kanji-app]')!;
  const controls = app.querySelector<HTMLElement>('[data-kanji-controls]')!;
  const charEl = document.getElementById('kanji-char')!;
  const meta = app.querySelector<HTMLElement>('[data-kanji-meta]')!;
  const count = app.querySelector<HTMLElement>('[data-kanji-count]')!;
  const revealBtn = app.querySelector<HTMLButtonElement>('[data-reveal]')!;
  const quiz = app.querySelector<HTMLInputElement>('[data-quiz]')!;
  const displace = document.querySelector('#kanji-develop feDisplacementMap')!;
  const join = (xs: string[]) => (xs.length ? xs.join('、') : '—');

  let order = kanji.map((_, i) => i);
  let pos = 0;
  let frame = 0;

  const develop = () => {
    cancelAnimationFrame(frame);
    if (reduce.matches) return;
    const start = performance.now();
    charEl.classList.add('is-developing');
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 1100);
      displace.setAttribute('scale', String(110 * (1 - (1 - (1 - t) ** 4))));
      if (t < 1) frame = requestAnimationFrame(step);
      else charEl.classList.remove('is-developing');
    };
    frame = requestAnimationFrame(step);
  };

  const hint = app.querySelector<HTMLElement>('[data-quiz-hint]')!;
  const setRevealed = (shown: boolean) => {
    hint.hidden = !quiz.checked;
    meta.hidden = !shown;
    revealBtn.hidden = !quiz.checked || shown;
  };

  const show = () => {
    const k = kanji[order[pos]];
    charEl.textContent = k.char;
    document.getElementById('kanji-meaning')!.textContent = k.meanings.join(', ');
    document.getElementById('kanji-on')!.textContent = join(k.on);
    document.getElementById('kanji-kun')!.textContent = join(k.kun);
    count.textContent = `${String(pos + 1).padStart(2, '0')} / ${kanji.length}`;
    setRevealed(!quiz.checked);
    develop();
  };

  const move = (delta: number) => {
    pos = (pos + delta + order.length) % order.length;
    show();
  };

  app.querySelector('[data-next]')!.addEventListener('click', () => move(1));
  app.querySelector('[data-prev]')!.addEventListener('click', () => move(-1));
  app.querySelector('[data-shuffle]')!.addEventListener('click', () => {
    order = order.map((v) => [Math.random(), v] as const).sort((a, b) => a[0] - b[0]).map(([, v]) => v);
    pos = 0;
    show();
  });
  revealBtn.addEventListener('click', () => setRevealed(true));
  quiz.addEventListener('change', () => setRevealed(!quiz.checked));
  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, textarea, select')) return;
    if (e.key === 'ArrowRight') move(1);
    else if (e.key === 'ArrowLeft') move(-1);
    else if (e.key === ' ' && quiz.checked && meta.hidden) {
      e.preventDefault();
      setRevealed(true);
    }
  });

  controls.hidden = false;
</script>

<style>
  .kanji-page { padding-block: var(--space-xl) 0; }
  .kanji-page__head { display: grid; gap: var(--space-m); margin-bottom: var(--space-xl); }
  .kanji-page__head a { text-decoration: none; }
  .kanji-page__intro { font-size: var(--step-1); color: var(--text-muted); max-width: 46ch; }
  .kanji-page__filters { position: absolute; }

  .kanji-page__stage {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    padding: var(--space-xl) var(--space-l);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .kanji-page__count { color: var(--text-muted); justify-self: start; }
  .kanji-page__char {
    font-family: var(--font-serif);
    font-size: clamp(9rem, 6rem + 14vw, 20rem);
    line-height: 1;
    max-width: none;
    pointer-events: none; /* its noise and blur overflow its box; never let it swallow clicks on the controls */
  }
  .kanji-page__char.is-developing { filter: url(#kanji-develop); }
  @media (prefers-reduced-motion: no-preference) {
    .kanji-page__char.is-developing { animation: kanji-focus 1.1s var(--ease-out) both; }
    @keyframes kanji-focus {
      from { opacity: 0.2; filter: url(#kanji-develop) blur(14px); }
    }
  }

  .kanji-page__meta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-s) var(--space-xl); text-align: center; }
  .kanji-page__meta dt { font-size: var(--step--1); color: var(--text-muted); }
  .kanji-page__meta dd { margin: 0; font-size: var(--step-1); }
  #kanji-meaning { color: var(--gold); }

  .kanji-page__controls { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-s); }
  .kanji-page__quiz { display: inline-flex; gap: 0.5em; align-items: center; margin-left: var(--space-s); cursor: pointer; }
  .kanji-page__quiz input { accent-color: var(--text); }
  .kanji-page__keys { width: 100%; text-align: center; }

  .kanji-page__nojs { margin-block: var(--space-l) var(--space-m); color: var(--text-muted); }
  .kanji-page__table { width: 100%; border-collapse: collapse; }
  .kanji-page__table th, .kanji-page__table td { padding: var(--space-xs) var(--space-s); border-bottom: 1px solid var(--border); text-align: left; }

  .kanji-page__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }
  .kanji-page__cta p { font-size: var(--step-1); }
</style>
