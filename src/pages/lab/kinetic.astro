---
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import { layoutWords } from '../../lib/kinetic';
import { site } from '../../site.config';

const example = 'Plan the day, keep distractions out.';
const words = layoutWords(example);
---

<Base
  title={`Kinetic Type from Voice | ${site.name}`}
  description="Say a line and it animates as kinetic typography, with the easing and timing of an After Effects edit."
>
  <div class="wrap kinetic-page">
    <header class="kinetic-page__head">
      <a class="label" href="/lab">← Lab</a>
      <h1>Kinetic Type from Voice</h1>
      <p class="kinetic-page__intro">
        Say a line, or type it, and it plays back as kinetic typography: staggered entries, a hold on the last word and
        the longest word carrying the line. Rule-based, so the same line always cuts the same way.
      </p>
    </header>

    <!-- The stage: pre-set with an example so it reads without JavaScript. -->
    <div class="kinetic-page__stage" data-stage aria-live="polite" aria-label="Kinetic type stage">
      {
        words.map((w) => (
          <span
            class:list={['word', { accent: w.emphasis }]}
            style={`--size: ${w.size}; --weight: ${w.weight}`}
          >
            {w.text}
          </span>
        ))
      }
    </div>

    <form class="kinetic-page__controls" data-kinetic-form>
      <noscript><p class="kinetic-page__nojs">The animation needs JavaScript.</p></noscript>
      <div class="field">
        <label for="kinetic-line">Your line</label>
        <input id="kinetic-line" name="line" type="text" maxlength="120" value={example} autocomplete="off" />
      </div>
      <div class="field field--lang">
        <label for="kinetic-lang">Language</label>
        <span class="select">
          <select id="kinetic-lang" name="lang">
            <option value="en">English</option>
            <option value="ja">日本語</option>
          </select>
        </span>
      </div>
      <div class="kinetic-page__actions" data-kinetic-actions hidden>
        <button class="btn btn--primary" type="submit">Animate</button>
        <button class="btn btn--secondary" type="button" data-replay>Replay</button>
        <button class="btn btn--secondary kinetic-page__talk" type="button" data-talk hidden>
          <span class="kinetic-page__dot" aria-hidden="true"></span>Hold to talk
        </button>
        <p class="kinetic-page__status label" data-status role="status"></p>
      </div>
    </form>

    <aside class="kinetic-page__cta">
      <p>Built for campaign sites: let visitors put their own words into your client's motion system.</p>
      <BookCall variant="primary" />
    </aside>
  </div>
</Base>

<script>
  import { layoutWords } from '../../lib/kinetic';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const form = document.querySelector<HTMLFormElement>('[data-kinetic-form]')!;
  const input = form.querySelector<HTMLInputElement>('#kinetic-line')!;
  const langSel = form.querySelector<HTMLSelectElement>('#kinetic-lang')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const talk = form.querySelector<HTMLButtonElement>('[data-talk]')!;

  const play = () => {
    const lang = langSel.value as 'en' | 'ja';
    const words = layoutWords(input.value, lang);
    stage.lang = lang;
    stage.replaceChildren(
      ...words.map((w) => {
        const el = document.createElement('span');
        el.className = w.emphasis ? 'word accent' : 'word';
        el.textContent = w.text;
        el.style.setProperty('--size', String(w.size));
        el.style.setProperty('--weight', String(w.weight));
        const frames: Keyframe[] = reduce.matches
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
              { opacity: 0, transform: `translateY(${w.rise}em) scale(0.6)`, filter: 'blur(6px)' },
              { opacity: 1, transform: 'translateY(0) scale(1.06)', filter: 'blur(0)', offset: 0.7 },
              { opacity: 1, transform: 'none', filter: 'blur(0)' },
            ];
        el.animate(frames, {
          duration: reduce.matches ? 200 : 700,
          delay: w.delay,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          fill: 'backwards',
        });
        return el;
      }),
    );
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    play();
  });
  form.querySelector('[data-replay]')!.addEventListener('click', play);

  // Hold-to-talk, only where the browser can recognise speech (Chrome, Edge).
  const Recognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  if (Recognition) {
    talk.hidden = false;
    let rec: any = null;
    const begin = () => {
      rec = new Recognition();
      rec.lang = langSel.value === 'ja' ? 'ja-JP' : 'en-GB';
      rec.interimResults = false;
      rec.onresult = (e: any) => {
        input.value = e.results[0][0].transcript;
        play();
      };
      rec.onerror = () => (status.textContent = 'Could not hear that. Try again or type the line.');
      rec.onend = () => talk.classList.remove('is-listening');
      status.textContent = 'Listening…';
      talk.classList.add('is-listening');
      rec.start();
    };
    const end = () => {
      rec?.stop();
      status.textContent = '';
    };
    talk.addEventListener('pointerdown', begin);
    talk.addEventListener('pointerup', end);
    talk.addEventListener('pointerleave', () => rec && end());
    talk.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && (e.preventDefault(), begin()));
    talk.addEventListener('keyup', (e) => e.key === ' ' && end());
  }

  form.querySelector<HTMLElement>('[data-kinetic-actions]')!.hidden = false;
</script>

<style>
  .kinetic-page { padding-block: var(--space-xl) 0; }
  .kinetic-page__head { display: grid; gap: var(--space-m); margin-bottom: var(--space-xl); }
  .kinetic-page__head a { text-decoration: none; }
  .kinetic-page__intro { font-size: var(--step-1); color: var(--text-muted); max-width: 48ch; }

  .kinetic-page__stage {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    align-items: baseline;
    gap: 0.1em 0.35em;
    min-height: 22rem;
    padding: var(--space-xl) var(--space-l);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    overflow: hidden;
  }
  .kinetic-page__stage:lang(ja) { letter-spacing: 0; }
  .word { display: inline-block; font-size: calc(var(--size) * 1em); font-weight: var(--weight); }

  .kinetic-page__controls { display: grid; gap: var(--space-m); margin-top: var(--space-l); max-width: 44rem; }
  .field { display: grid; gap: 0.35rem; }
  .field label { font-size: var(--step--1); font-weight: 500; }
  .field input,
  .field select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6em 0.8em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .select { position: relative; display: block; max-width: 14rem; }
  .select select { appearance: none; padding-right: 2.5em; cursor: pointer; }
  .select::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1em;
    width: 0.5em;
    height: 0.5em;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    translate: 0 -70%;
    rotate: 45deg;
    pointer-events: none;
  }
  .kinetic-page__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); }
  .kinetic-page__talk { gap: 0.6em; touch-action: none; user-select: none; }
  .kinetic-page__dot { width: 8px; height: 8px; rotate: 45deg; background: var(--text-muted); }
  .kinetic-page__talk.is-listening .kinetic-page__dot { background: var(--rust); }
  .kinetic-page__status { min-height: 1em; }
  .kinetic-page__nojs { color: var(--text-muted); }

  .kinetic-page__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }
  .kinetic-page__cta p { font-size: var(--step-1); max-width: 48ch; }
</style>
