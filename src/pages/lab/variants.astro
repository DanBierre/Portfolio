---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import { variants, headlines, type Shot } from '../../data/lab/variants';
import { site } from '../../site.config';
import todayLight from '../../assets/work/shoji/today-light.png';
import todayDark from '../../assets/work/shoji/today-dark.png';
import insightsLight from '../../assets/work/shoji/insights-light.png';

const shotImages: Record<Shot, ImageMetadata> = {
  'today-light': todayLight,
  'today-dark': todayDark,
  'insights-light': insightsLight,
};
const all = variants();
const langName = { en: 'English', ja: 'Japanese' } as const;
---

<Base
  title={`Campaign Variant Machine | ${site.name}`}
  description="One product, one headline in; twenty-four on-brand launch ads out, in English and Japanese. A rule-based variant pipeline for Shoji."
>
  <div class="wrap variants-page">
    <header class="variants-page__head">
      <a class="label" href="/lab">← Lab</a>
      <h1>Campaign Variant Machine</h1>
      <p class="variants-page__intro">
        A launch campaign for Shoji, my desktop planner. One set of inputs goes in; twenty-four on-brand ads come out,
        half in Japanese. Hover or focus any ad to see its recipe.
      </p>
      <p class="label variants-page__honest">
        Rule-based pipeline: real Shoji screenshots × 4 layouts × 2 colourways × 2 languages. No image model.
      </p>
    </header>

    <section class="variants-page__inputs" aria-label="Inputs">
      <div class="input">
        <span class="label">product</span>
        <Picture src={todayLight} widths={[160]} sizes="5rem" formats={['avif', 'webp']} alt="Shoji Today screen" class="input__shot" />
      </div>
      <div class="input input--copy">
        <span class="label">headlines</span>
        <p>{headlines.en[0]}</p>
        <p lang="ja">{headlines.ja[0]}</p>
      </div>
      <div class="input">
        <span class="label">brand</span>
        <span class="swatches" role="img" aria-label="Brand colours: ink, washi, rust">
          <span style="background:#141414"></span><span style="background:#d8d7d2"></span><span style="background:#c8613a"></span>
        </span>
      </div>
      <div class="input input--run" data-run hidden>
        <button class="btn btn--primary" type="button" data-generate>Generate</button>
        <span class="num variants-page__count" data-tile-count aria-live="polite">0 / 24</span>
      </div>
    </section>

    <div class="variants-page__grid" data-grid>
      {
        all.map((v) => (
          <article
            class:list={['tile', `tile--${v.layout}`, `tile--${v.colourway}`]}
            lang={v.lang}
            tabindex="0"
            data-tile
            aria-label={`Variant ${v.id + 1}: ${v.layout} layout, ${v.colourway}, ${langName[v.lang]}`}
          >
            <Picture
              src={shotImages[v.shot]}
              widths={[240, 440]}
              sizes="(min-width: 64em) 15vw, 45vw"
              formats={['avif', 'webp']}
              alt=""
              class="tile__shot"
            />
            <p class="tile__headline">{v.headline}</p>
            <p class="tile__brand">Shoji</p>
            <dl class="recipe" lang="en">
              <div><dt>layout</dt><dd>{v.layout}</dd></div>
              <div><dt>colourway</dt><dd>{v.colourway}</dd></div>
              <div><dt>language</dt><dd>{langName[v.lang]}</dd></div>
              <div><dt>shot</dt><dd>{v.shot}</dd></div>
            </dl>
          </article>
        ))
      }
    </div>

    <aside class="variants-page__cta">
      <p>The same idea scales to your client's catalogue: generated imagery, localised copy, on brand every time.</p>
      <BookCall variant="primary" />
    </aside>
  </div>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-tile]')];
  const count = document.querySelector<HTMLElement>('[data-tile-count]')!;
  const button = document.querySelector<HTMLButtonElement>('[data-generate]')!;
  let timers: number[] = [];

  const reset = () => {
    timers.forEach(clearTimeout);
    timers = [];
    tiles.forEach((t) => (t.hidden = true));
    count.textContent = `0 / ${tiles.length}`;
  };

  const generate = () => {
    reset();
    if (reduce.matches) {
      tiles.forEach((t) => (t.hidden = false));
      count.textContent = `${tiles.length} / ${tiles.length}`;
    } else {
      tiles.forEach((t, i) => {
        timers.push(
          window.setTimeout(() => {
            t.hidden = false;
            t.animate(
              [
                { opacity: 0, transform: 'translateY(12px) scale(0.97)', filter: 'blur(6px)' },
                { opacity: 1, transform: 'none', filter: 'blur(0)' },
              ],
              { duration: 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
            );
            count.textContent = `${i + 1} / ${tiles.length}`;
          }, i * 90),
        );
      });
    }
    button.textContent = 'Regenerate';
  };

  button.addEventListener('click', generate);
  reset();
  document.querySelector<HTMLElement>('[data-run]')!.hidden = false;
</script>

<style>
  .variants-page { padding-block: var(--space-xl) 0; }
  .variants-page__head { display: grid; gap: var(--space-m); margin-bottom: var(--space-xl); }
  .variants-page__head a { text-decoration: none; }
  .variants-page__intro { font-size: var(--step-1); color: var(--text-muted); max-width: 48ch; }
  .variants-page__honest { text-transform: none; }

  .variants-page__inputs {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-l) var(--space-xl);
    padding-block: var(--space-m);
    margin-bottom: var(--space-l);
    border-block: 1px solid var(--border);
  }
  .input { display: grid; gap: var(--space-xs); }
  .input :global(.input__shot) { width: 4rem; aspect-ratio: 1; object-fit: cover; object-position: 50% 0; border-radius: 4px; }
  .input--copy p { max-width: none; }
  .swatches { display: flex; gap: 6px; }
  .swatches span { width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1px solid var(--border); }
  .input--run { margin-left: auto; display: flex; align-items: center; gap: var(--space-m); }
  .variants-page__count { color: var(--text-muted); min-width: 4.5ch; }

  .variants-page__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-s); }
  @media (min-width: 48em) { .variants-page__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 72em) { .variants-page__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }

  /* An ad card. Colourways scope their own ink, as the site's bands do. */
  .tile {
    --t-bg: #141414;
    --t-ink: #ecebe7;
    --t-accent: #c8613a;
    position: relative;
    display: grid;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 8%;
    background: var(--t-bg);
    color: var(--t-ink);
    border: 1px solid var(--border);
    font-size: clamp(0.7rem, 0.5rem + 0.6vw, 1rem);
  }
  .tile--washi { --t-bg: #d8d7d2; --t-ink: #141414; --t-accent: #8a3c21; }
  .tile:focus-visible { outline-offset: 2px; }
  .tile :global(.tile__shot) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; border-radius: 3px; }
  .tile__headline { font-size: 1.35em; line-height: 1.05; letter-spacing: -0.03em; font-weight: 500; max-width: none; }
  .tile:lang(ja) .tile__headline { letter-spacing: 0; line-height: 1.25; font-weight: 600; }
  .tile__brand { font-size: 0.75em; color: var(--t-accent); font-weight: 600; }

  .tile--poster { grid-template-rows: auto minmax(0, 1fr) auto; gap: 6%; }
  .tile--poster .tile__headline { order: -1; font-size: 1.6em; }
  .tile--split { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; gap: 6%; align-items: center; }
  .tile--split :global(.tile__shot) { grid-row: 1 / -1; }
  .tile--crop { padding: 0; }
  .tile--crop :global(.tile__shot) { position: absolute; inset: 0; border-radius: 0; }
  .tile--crop .tile__headline,
  .tile--crop .tile__brand { position: relative; z-index: 1; margin-inline: 6%; padding: 4% 6%; background: var(--t-bg); }
  .tile--crop .tile__headline { align-self: end; margin-bottom: 0; }
  .tile--crop .tile__brand { margin-bottom: 6%; }
  .tile--type { grid-template-rows: 1fr auto; }
  .tile--type .tile__headline { font-size: 1.85em; align-self: center; max-width: 68%; } /* clears the corner shot */
  .tile--type :global(.tile__shot) { position: absolute; right: 8%; bottom: 8%; width: 28%; height: auto; aspect-ratio: 1; }

  /* The recipe: the site's "how it was made" readout, shown on hover or focus. */
  .recipe {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px 8px;
    padding: 8px 10px;
    background: rgb(20 20 20 / 0.94);
    color: #ecebe7;
    font-size: 11px;
    line-height: 1.3;
    opacity: 0;
    translate: 0 100%;
    transition: opacity 0.2s var(--ease-out), translate 0.3s var(--ease-out);
  }
  .recipe dt { color: #9d9b95; }
  .recipe dd { margin: 0; font-family: var(--font-data); }
  .tile:hover .recipe,
  .tile:focus-visible .recipe,
  .tile:focus .recipe { opacity: 1; translate: 0 0; }
  @media (prefers-reduced-motion: reduce) {
    .recipe { transition: none; }
  }

  .variants-page__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }
  .variants-page__cta p { font-size: var(--step-1); max-width: 48ch; }
</style>
