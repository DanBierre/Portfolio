---
// The page as an edit timeline: a rust playhead runs along the top as you scroll and a timecode
// counts the frames (24 fps), plus a paper-lantern glow that follows the pointer. Decorative only.
---

<div class="playhead" aria-hidden="true"></div>
<p class="timecode label" aria-hidden="true">TC <span data-timecode>00:00:00:00</span></p>
<div class="lamp" aria-hidden="true"></div>

<script>
  const tc = document.querySelector<HTMLElement>('[data-timecode]');
  const lamp = document.querySelector<HTMLElement>('.lamp');
  const PX_PER_FRAME = 6;
  const two = (n: number) => String(n).padStart(2, '0');
  let queued = false;
  let x = 0, y = 0;

  const paint = () => {
    queued = false;
    if (tc) {
      const f = Math.round(scrollY / PX_PER_FRAME);
      const s = Math.floor(f / 24);
      tc.textContent = `${two(Math.floor(s / 3600))}:${two(Math.floor(s / 60) % 60)}:${two(s % 60)}:${two(f % 24)}`;
    }
    lamp?.style.setProperty('translate', `${x}px ${y}px`);
  };
  const queue = () => {
    if (!queued) (queued = true), requestAnimationFrame(paint);
  };
  addEventListener('scroll', queue, { passive: true });
  if (lamp && matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    addEventListener('pointermove', (e) => {
      (x = e.clientX), (y = e.clientY);
      lamp.classList.add('is-lit');
      queue();
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => lamp.classList.remove('is-lit'));
  }
  paint();
</script>

<style>
  .playhead,
  .timecode,
  .lamp { display: none; }

  @media (min-width: 64em) {
    .timecode {
      display: block;
      position: fixed;
      left: var(--spine-x, var(--gutter));
      bottom: var(--space-s);
      z-index: 20;
      margin: 0;
      font-family: var(--font-data);
      font-variant-numeric: tabular-nums;
      color: var(--text-muted);
      pointer-events: none;
    }
    /* Off the end of the timeline: clear the footer's contact row. With reduced motion the scroll-linked
       timecode is decorative noise, so it is not shown at all. */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: scroll()) {
        .timecode { animation: tc-out linear both; }
        @keyframes tc-out { 0%, 93% { opacity: 1; } 97%, 100% { opacity: 0; } }
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .timecode { display: none; }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .playhead {
        display: block;
        position: fixed;
        inset: 0 0 auto;
        height: 2px;
        z-index: 60;
        background: var(--rust);
        transform-origin: left;
        animation: playhead linear both;
        pointer-events: none;
      }
      @keyframes playhead { from { scale: 0 1; } }
    }
  }

  /* Warm light through paper: a soft glow under the pointer, screen-blended so it only ever lightens. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .lamp {
      display: block;
      position: fixed;
      top: -18rem;
      left: -18rem;
      width: 36rem;
      height: 36rem;
      z-index: 50;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgb(201 162 79 / 0.09), rgb(200 97 58 / 0.03) 55%, transparent);
      mix-blend-mode: screen;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.6s var(--ease-out);
    }
    .lamp.is-lit { opacity: 1; }
  }

  /* Timelines live in their own @supports block: CSS minifiers fold animation-timeline into the
     animation shorthand, which browsers reject, so it must not share a rule with the shorthand. */
  @supports (animation-range: entry 0%) {
    .timecode { animation-timeline: scroll(root); }
    .playhead { animation-timeline: scroll(root); }
  }
</style>
