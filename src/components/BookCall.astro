---
import { ui, langOf, homeOf } from '../i18n/ui';

interface Props {
  variant?: 'primary' | 'secondary' | 'nav';
  label?: string;
  class?: string;
}

const lang = langOf(Astro.currentLocale);
const { variant = 'primary', label = ui[lang].bookCall, class: className } = Astro.props;
---

<a href={`${homeOf(lang)}#contact`} class:list={['btn', `btn--${variant}`, className]} data-umami-event="book_call_click">{label}</a>
