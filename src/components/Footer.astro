---
import { site } from '../site.config';
import CopyEmail from './CopyEmail.astro';
import { langOf } from '../i18n/ui';
import { brushRing } from '../lib/enso';

const year = new Date().getFullYear();
const lang = langOf(Astro.currentLocale);

// The page ends like the edit at its top: a short credit roll, the 終 card and an ensō.
const credits =
  lang === 'ja'
    ? [
        ['デザイン・コード', 'Dan Bierre'],
        ['編集・グレーディング', 'Dan Bierre'],
        ['映像素材', 'Pexels'],
        ['制作', 'オークランド → 日本'],
      ]
    : [
        ['Design & code', 'Dan Bierre'],
        ['Edit & grade', 'Dan Bierre'],
        ['Footage', 'Pexels'],
        ['Made in', 'Auckland → Japan'],
      ];
const ring = brushRing({ r: 40, width: 7, seed: 5 });
---

<footer class="site-footer">
  <div class="wrap credits">
    <p class="credits__fin" lang="ja" aria-hidden="true">終</p>
    <dl class="credits__roll">
      {
        credits.map(([term, name]) => (
          <div>
            <dt>{term}</dt>
            <dd>{name}</dd>
          </div>
        ))
      }
    </dl>
    <svg class="credits__enso" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <path d={ring} fill="currentColor"></path>
    </svg>
  </div>
  <div class="wrap footer__row">
    <CopyEmail />
    <a href={site.linkedin}>LinkedIn</a>
    <a class="footer__top" href="#main">{lang === 'ja' ? 'トップへ' : 'Back to top'} <span aria-hidden="true">↑</span></a>
    <p class="footer__legal">© {year}</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-2xl) var(--space-l); overflow: hidden; }

  /* Credits: centred on a gutter, roles right-aligned to the left of it and names to the right,
     as on a film's end roll. */
  .credits { display: grid; justify-items: center; gap: var(--space-l); padding-bottom: var(--space-xl); }
  .credits__fin {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    /* System Mincho: the web Mincho is a Latin subset without 終, so loading it here would only cost bytes. */
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', 'YuMincho', serif;
    font-size: var(--step-3);
    color: var(--text);
  }
  .credits__fin::before,
  .credits__fin::after { content: ''; width: 3rem; height: 1px; background: var(--border); }
  .credits__roll { display: grid; gap: 0.7em; margin: 0; }
  .credits__roll > div { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--space-m); }
  .credits__roll dt {
    text-align: right;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    align-self: center;
  }
  .credits__roll dd { margin: 0; font-size: var(--step-1); }
  .credits__enso { width: 3.5rem; height: 3.5rem; color: var(--rust); }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .footer__top { margin-left: auto; text-decoration: none; color: var(--text-muted); }
  .footer__top:hover { color: var(--text); }
  .footer__legal { margin: 0; color: var(--text-muted); font-family: var(--font-data); }

  /* Phones: contact on its own line, then LinkedIn, top and © on one line. */
  @media (max-width: 47.99em) {
    .footer__row > :first-child { flex-basis: 100%; }
    .credits__roll dd { font-size: var(--step-0); }
  }
</style>
