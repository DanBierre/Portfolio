---
import { site } from '../site.config';
import CopyEmail from './CopyEmail.astro';
import { langOf, homeOf } from '../i18n/ui';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer">
    <a class="footer__mark" href={homeOf(langOf(Astro.currentLocale))}>{site.name}</a>
    <div class="footer__row">
      <CopyEmail />
      <a href={site.linkedin}>LinkedIn</a>
      <p class="footer__legal">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-xl) var(--space-l); overflow: hidden; }
  .footer { display: grid; gap: var(--space-l); }
  /* Kolkhoze-style closing wordmark: lowercase, enormous. */
  .footer__mark {
    font-size: min(18vw, 22rem);
    font-weight: 430;
    letter-spacing: -0.04em;
    line-height: 0.8;
    text-transform: lowercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-m) var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .footer__legal { margin-left: auto; color: var(--text-muted); }
</style>
