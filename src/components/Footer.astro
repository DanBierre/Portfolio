---
import CopyEmail from './CopyEmail.astro';
import { langOf } from '../i18n/ui';
import { brushRing } from '../lib/enso';

const year = new Date().getFullYear();
const lang = langOf(Astro.currentLocale);
const ring = brushRing({ r: 40, width: 7, seed: 5 });
---

<!-- The page ends on its mark: an ensō and 終, then the way to get in touch. -->
<footer class="site-footer">
  <div class="wrap footer__row">
    <p class="footer__fin" aria-hidden="true">
      <svg class="footer__enso" viewBox="0 0 100 100" focusable="false">
        <path d={ring} fill="currentColor"></path>
      </svg>
      <span lang="ja">終</span>
    </p>
    <CopyEmail />
    <a href="https://softlightsoftware.dev">Soft Light Software</a>
    <a class="footer__top" href="#main">{lang === 'ja' ? 'トップへ' : 'Back to top'} <span aria-hidden="true">↑</span></a>
    <p class="footer__legal">© {year} Dan Bierre, {lang === 'ja' ? 'オークランド' : 'Auckland'}</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-2xl) var(--space-l); }

  /* Wide screens: the footer starts on the same edge as every scene's content. */
  @media (min-width: 64em) {
    .site-footer > .wrap { padding-left: calc(var(--spine-x) + 2.5rem); }
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    font-size: var(--step--1);
  }
  .footer__fin {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin: 0 auto 0 0;
    /* System Mincho: the web Mincho is a Latin subset without 終, so loading it here would only cost bytes. */
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', 'YuMincho', serif;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--text);
  }
  .footer__enso { width: 1.1em; height: 1.1em; color: var(--rust); }
  .footer__top { text-decoration: none; color: var(--text-muted); }
  .footer__top:hover { color: var(--text); }
  .footer__legal { margin: 0; color: var(--text-muted); }

  /* Phones: the mark on its own line, the links wrap underneath. */
  @media (max-width: 47.99em) {
    .footer__fin { flex-basis: 100%; margin-bottom: var(--space-s); }
  }
</style>
