---
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import BookCall from './BookCall.astro';

const [work, lab] = await Promise.all([getCollection('work'), getCollection('lab')]);
const links = [
  { href: '/#work', label: 'Work', count: work.length },
  { href: '/#services', label: 'Services' },
  { href: '/lab', label: 'Lab', count: lab.length },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header">
  <nav class="wrap nav" aria-label="Main">
    <a class="nav__brand" href="/">{site.name}</a>
    <ul class="nav__links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>
              {l.label}
              {l.count !== undefined && <sup aria-hidden="true">[{l.count}]</sup>}
            </a>
          </li>
        ))
      }
    </ul>
    <details class="nav__menu">
      <summary>Menu</summary>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                {l.label}
                {l.count !== undefined && <sup aria-hidden="true">[{l.count}]</sup>}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <BookCall variant="nav" class="nav__cta" />
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: 3.75rem;
    text-transform: lowercase;
  }
  .nav__brand { font-weight: 500; letter-spacing: -0.02em; text-decoration: none; margin-right: auto; }
  .nav a:not(.btn) { text-decoration: none; }
  .nav__links { display: flex; gap: var(--space-l); padding: 0; list-style: none; }
  .nav__links a { color: var(--text-muted); transition: color 0.2s; }
  .nav__links a:hover { color: var(--text); }
  sup { font-size: 0.7em; margin-left: 0.15em; }
  .nav__menu { display: none; }

  @media (max-width: 47.99em) {
    .nav__links,
    .nav :global(.nav__cta) { display: none; }
    .nav__menu { display: block; }
    .nav__menu summary {
      list-style: none;
      cursor: pointer;
      padding: var(--space-xs) 0;
      color: var(--text-muted);
    }
    .nav__menu summary::-webkit-details-marker { display: none; }
    .nav__menu[open] summary { color: var(--text); }
    .nav__menu ul {
      position: absolute;
      inset: 100% 0 auto 0;
      display: grid;
      padding: var(--space-s) var(--gutter) var(--space-l);
      margin: 0;
      list-style: none;
      background: var(--ground);
      border-bottom: 1px solid var(--border);
    }
    .nav__menu ul a {
      display: block;
      padding: var(--space-xs) 0;
      font-size: var(--step-4);
      letter-spacing: -0.045em;
      line-height: 1;
    }
  }
</style>
