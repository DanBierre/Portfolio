---
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { ui, langOf, homeOf } from '../i18n/ui';
import BookCall from './BookCall.astro';

const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const home = homeOf(lang);
const other = lang === 'ja' ? 'en' : 'ja';

const work = await getCollection('work');
const anchor = (id: string) => (lang === 'ja' ? `/ja#${id}` : `/#${id}`);
const links = [
  { href: anchor('about'), label: t.nav.about },
  { href: anchor('work'), label: t.nav.work, count: work.length },
  { href: anchor('services'), label: t.nav.services },
];
---

<header class="site-header">
  <nav class="wrap nav" aria-label={lang === 'ja' ? 'メイン' : 'Main'}>
    <a class="nav__brand" href={home}>{site.name}</a>
    <ul class="nav__links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>
              {l.label}
              {l.count !== undefined && <sup class="num" aria-hidden="true">[{l.count}]</sup>}
            </a>
          </li>
        ))
      }
    </ul>
    <details class="nav__menu">
      <summary>{t.nav.menu}</summary>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                {l.label}
                {l.count !== undefined && <sup class="num" aria-hidden="true">[{l.count}]</sup>}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <div class="nav__switches">
      <a class="nav__switch" href={homeOf(other)} hreflang={other} lang={other} aria-label={`${t.langLabel}: ${t.langSwitchName}`}
        >{t.langLabel}</a
      >
      <button class="nav__switch" type="button" data-theme-toggle data-to-light={t.themeToLight} data-to-dark={t.themeToDark} hidden
        ><span class="when-dark" aria-hidden="true">{lang === 'ja' ? 'ライト' : 'light'}</span><span
          class="when-light"
          aria-hidden="true">{lang === 'ja' ? 'ダーク' : 'dark'}</span
        ></button
      >
    </div>
    <BookCall variant="nav" class="nav__cta" />
  </nav>
</header>

<script>
  // Light/dark toggle. The saved choice is applied before paint by Base.astro; dark is the default.
  const root = document.documentElement;
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => {
      const light = root.dataset.theme === 'light';
      btn.setAttribute('aria-label', light ? btn.dataset.toDark! : btn.dataset.toLight!);
      btn.setAttribute('aria-pressed', String(light));
    };
    const apply = () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      if (next === 'light') root.dataset.theme = 'light';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    };
    // Swap under the peak, let the restyle land while still covered, then burn back in.
    btn.addEventListener('click', () =>
      burn(btn, () => {
        apply();
        requestAnimationFrame(() => requestAnimationFrame(() => root.classList.replace('burn-up', 'burn-down')));
      }),
    );
    btn.hidden = false;
    sync();
  }

  // Film burn (motion.css): burn out from the switch, swap under the peak. Instant with reduced motion.
  const PEAK_MS = 420;
  function burn(from: Element, atPeak: () => void) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return atPeak();
    const r = from.getBoundingClientRect();
    root.style.setProperty('--burn-x', `${Math.round(r.left + r.width / 2)}px`);
    root.style.setProperty('--burn-y', `${Math.round(r.top + r.height / 2)}px`);
    root.classList.remove('burn-down', 'burn-hold');
    root.classList.add('burn-up');
    setTimeout(atPeak, PEAK_MS);
  }

  // Language: burn out here, and the next page burns in (Base.astro reads the flag before paint).
  for (const a of document.querySelectorAll<HTMLAnchorElement>('nav a[hreflang]')) {
    a.addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // new tab etc.
      e.preventDefault();
      burn(a, () => {
        try {
          if (root.classList.contains('burn-up')) sessionStorage.setItem('burn', '1');
        } catch {}
        root.classList.replace('burn-up', 'burn-hold'); // keep flickering while the next page loads
        location.href = a.href;
      });
    });
  }
  // Back to this page from the history cache: don't come back mid-burn.
  addEventListener('pageshow', (e) => e.persisted && root.classList.remove('burn-up', 'burn-hold', 'burn-down'));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ground);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-height: 3.75rem;
    text-transform: lowercase;
  }
  .nav__brand { font-weight: 500; letter-spacing: -0.02em; text-decoration: none; margin-right: auto; }
  .nav a:not(.btn) { text-decoration: none; }
  .nav__links { display: flex; gap: var(--space-l); padding: 0; list-style: none; }
  .nav__links a, .nav__switch { color: var(--text-muted); transition: color 0.2s; }
  .nav__links a:hover, .nav__switch:hover { color: var(--text); }
  sup { font-size: 0.7em; margin-left: 0.15em; }
  .nav__menu { display: none; }

  .nav__switches { display: flex; gap: var(--space-s); align-items: center; }
  .nav__switch {
    padding: 0.2em 0.7em;
    font-size: var(--step--1);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }
  .nav__switch .when-light,
  :global([data-theme='light']) .nav__switch .when-dark { display: none; }
  :global([data-theme='light']) .nav__switch .when-light { display: inline; }

  /* Below 64em the section links fold into the menu; the booking pill stays until the mobile bar takes over. */
  @media (max-width: 47.99em) {
    .nav :global(.nav__cta) { display: none; }
  }
  @media (max-width: 63.99em) {
    .nav { gap: var(--space-s); }
    .nav__links { display: none; }
    .nav__menu { display: block; }
    .nav__menu summary {
      list-style: none;
      cursor: pointer;
      padding: var(--space-xs) 0;
      color: var(--text-muted);
    }
    .nav__menu summary::-webkit-details-marker { display: none; }
    .nav__menu[open] summary { color: var(--text); }
    .nav__menu ul {
      position: absolute;
      inset: 100% 0 auto 0;
      display: grid;
      padding: var(--space-s) var(--gutter) var(--space-l);
      margin: 0;
      list-style: none;
      background: var(--ground);
      border-bottom: 1px solid var(--border);
    }
    .nav__menu ul a {
      display: block;
      padding: var(--space-xs) 0;
      font-size: var(--step-4);
      letter-spacing: -0.04em;
      line-height: 1;
    }
  }
</style>
