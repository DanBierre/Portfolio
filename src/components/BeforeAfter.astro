---
import { Picture } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption: string;
}

const { before, after, beforeAlt, afterAlt, caption } = Astro.props;
const pic = { formats: ['avif', 'webp'] as const, widths: [640, 1024, 1600], sizes: '(min-width: 90rem) 85rem, 100vw' };
---

<figure class="ba" data-before-after style="--pos: 50%">
  <div class="ba__frame">
    <Picture src={before} alt={beforeAlt} {...pic} formats={[...pic.formats]} class="ba__img" />
    <div class="ba__after">
      <Picture src={after} alt={afterAlt} {...pic} formats={[...pic.formats]} class="ba__img" />
    </div>
    <span class="ba__label ba__label--before" aria-hidden="true">Before</span>
    <span class="ba__label ba__label--after" aria-hidden="true">After</span>
    <span class="ba__divider" aria-hidden="true"></span>
    <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Reveal before and after" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-before-after]')) {
    const range = fig.querySelector<HTMLInputElement>('.ba__range')!;
    range.addEventListener('input', () => fig.style.setProperty('--pos', `${range.value}%`));
  }
</script>

<style>
  .ba { display: grid; gap: var(--space-s); }
  .ba__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface);
    touch-action: pan-y;
  }
  .ba__frame :global(.ba__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba__after { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos)); }
  .ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    translate: -1px 0;
    background: #fff;
    pointer-events: none;
  }
  .ba__divider::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.25);
  }
  .ba__label {
    position: absolute;
    bottom: var(--space-s);
    padding: 0.2em 0.6em;
    border-radius: 999px;
    font-size: var(--step--1);
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    pointer-events: none;
  }
  .ba__label--before { left: var(--space-s); }
  .ba__label--after { right: var(--space-s); }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba__frame:has(.ba__range:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  figcaption { font-size: var(--step--1); color: var(--text-muted); }
</style>
