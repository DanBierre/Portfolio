---
import { BUDGET_OPTIONS, site } from '../site.config';
import { ui, langOf } from '../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];
---

<form class="brief" method="post" action="/api/brief" data-brief-form data-email={site.email} data-t={JSON.stringify(t.form)} novalidate>
  <div class="brief__row">
    <div class="field">
      <label for="brief-name">{t.form.name}</label>
      <input id="brief-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="brief-name-error" />
      <p class="field__error" id="brief-name-error" data-error-for="name"></p>
    </div>
    <div class="field">
      <label for="brief-email">{t.form.email}</label>
      <input id="brief-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="brief-email-error" />
      <p class="field__error" id="brief-email-error" data-error-for="email"></p>
    </div>
  </div>

  <div class="field">
    <label for="brief-website">{t.form.website} <span class="field__optional">{t.form.optional}</span></label>
    <input id="brief-website" name="website" type="text" inputmode="url" autocomplete="url" maxlength="300" placeholder={t.form.websiteHint} aria-describedby="brief-website-error" />
    <p class="field__error" id="brief-website-error" data-error-for="website"></p>
  </div>

  <div class="field">
    <label for="brief-project">{t.form.project}</label>
    <textarea id="brief-project" name="project" rows="4" required maxlength="5000" aria-describedby="brief-project-error"></textarea>
    <p class="field__error" id="brief-project-error" data-error-for="project"></p>
  </div>

  <div class="brief__row">
    <div class="field">
      <label for="brief-timeline">{t.form.timeline} <span class="field__optional">{t.form.optional}</span></label>
      <input id="brief-timeline" name="timeline" type="text" maxlength="200" placeholder={t.form.timelineHint} aria-describedby="brief-timeline-error" />
      <p class="field__error" id="brief-timeline-error" data-error-for="timeline"></p>
    </div>
  </div>

  <div class="brief__trap" aria-hidden="true">
    <label for="brief-hp">{t.form.trap}</label>
    <input id="brief-hp" name="hp_confirm" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="brief__submit">
    <button class="btn btn--primary" type="submit">{t.form.send}</button>
    <p class="brief__status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-brief-form]')) {
    const status = form.querySelector<HTMLElement>('.brief__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const { email } = form.dataset;
    const t = JSON.parse(form.dataset.t!) as Record<string, string>;

    const clearErrors = () => {
      for (const el of form.querySelectorAll<HTMLElement>('[data-error-for]')) el.textContent = '';
      for (const el of form.querySelectorAll('[aria-invalid]')) el.removeAttribute('aria-invalid');
    };
    const showErrors = (errors: Record<string, string>) => {
      for (const [name, message] of Object.entries(errors)) {
        const target = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (target) target.textContent = message;
        form.elements.namedItem(name) instanceof HTMLElement &&
          (form.elements.namedItem(name) as HTMLElement).setAttribute('aria-invalid', 'true');
      }
      (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
    };
    const fail = () => {
      status.dataset.state = 'error';
      status.replaceChildren(
        t.failed,
        Object.assign(document.createElement('a'), { href: `mailto:${email}`, textContent: email }),
        t.stop,
      );
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      status.textContent = '';
      delete status.dataset.state;

      if (!form.checkValidity()) {
        const errors: Record<string, string> = {};
        for (const el of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required], input[type="email"]')) {
          if (!el.validity.valid) {
            errors[el.name] =
              el.name === 'email' ? t.errEmail : el.name === 'name' ? t.errName : t.errProject;
          }
        }
        showErrors(errors);
        return;
      }

      button.disabled = true;
      button.textContent = t.sending;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          headers: { accept: 'application/json' },
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          form.reset();
          status.dataset.state = 'success';
          status.replaceChildren(t.thanks);
          (window as any).umami?.track('brief_submitted');
        } else if (res.status === 400 && body.errors) {
          showErrors(body.errors);
        } else {
          fail();
        }
      } catch {
        fail();
      } finally {
        button.disabled = false;
        button.textContent = t.send;
      }
    });
  }
</script>

<style>
  .brief { display: grid; gap: var(--space-m); width: 100%; }
  .brief__row { display: grid; gap: var(--space-m); }
  .field { display: grid; gap: 0.35rem; }
  label { font-size: var(--step--1); font-weight: 520; }
  .field__optional { color: var(--text-muted); font-weight: 400; }
  input,
  textarea,
  select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6em 0.8em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.2s;
  }
  textarea { resize: vertical; min-height: 7rem; }
  .select { position: relative; display: block; }
  .select select { appearance: none; padding-right: 2.5em; cursor: pointer; }
  .select::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1em;
    width: 0.5em;
    height: 0.5em;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    translate: 0 -70%;
    rotate: 45deg;
    pointer-events: none;
  }
  input:hover, textarea:hover, select:hover { border-color: var(--text-muted); }
  input:focus-visible, textarea:focus-visible, select:focus-visible { outline-offset: 1px; border-color: var(--text); }
  ::placeholder { color: var(--text-muted); opacity: 1; }
  [aria-invalid='true'] { border-color: var(--error); }
  .field__error { font-size: var(--step--1); color: var(--error); min-height: 0; }
  .field__error:empty { display: none; }
  .brief__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .brief__submit { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); }
  .brief__status { font-size: var(--step--1); }
  .brief__status[data-state='error'] { color: var(--error); }
  .brief__status a { color: inherit; }
  button[disabled] { opacity: 0.6; cursor: progress; }

  @media (min-width: 40em) {
    .brief__row { grid-template-columns: 1fr 1fr; }
  }
</style>
