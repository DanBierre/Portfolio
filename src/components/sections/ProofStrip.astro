---
import { Image } from 'astro:assets';
import { ui, langOf } from '../../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];

// Drop client/agency logos (with permission) into src/assets/logos/ and they replace the result line.
const logos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/logos/*.{svg,png}', { eager: true }),
).map(([path, mod]) => ({ src: mod.default, name: path.split('/').pop()!.replace(/\.\w+$/, '') }));
---

<section id="proof" class="proof spined" aria-label={t.proof.label}>
  <div class="wrap proof__rule">
    <span class="label" aria-hidden="true">{t.proof.label}</span>
    {
      logos.length > 0 ? (
        <ul class="proof__logos" role="list">
          {logos.map((l) => (
            <li>
              <Image src={l.src} alt={l.name} height={28} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="proof__result">{t.proof.result}</p>
      )
    }
    <span class="label" aria-hidden="true">{t.proof.end}</span>
  </div>
</section>

<style>
  /* Vècna-style hairline with a label at each end. */
  .proof__rule {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-m);
    border-block: 1px solid var(--border);
  }
  .proof__result { max-width: none; text-align: center; }
  .proof__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-l) var(--space-xl);
    padding: 0;
    list-style: none;
  }
  .proof__logos :global(img) { height: 1.75rem; width: auto; opacity: 0.8; filter: grayscale(1) invert(1); }

  @media (max-width: 47.99em) {
    .proof__rule { grid-template-columns: 1fr; }
    .proof__rule .label { display: none; }
    .proof__result { text-align: left; }
  }
</style>
