---
import BookCall from '../BookCall.astro';
import SpineMark from '../SpineMark.astro';
import { ui, langOf } from '../../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];
---

<section id="process" class="process spined" aria-labelledby="process-title">
  <SpineMark section="process" />
  <div class="wrap">
    <h2 id="process-title">{t.process.title}<span class="count" aria-hidden="true">{t.process.steps.length}</span></h2>
    <ol class="process__steps" role="list">
      {
        t.process.steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="process__cta">
      <BookCall variant="primary" label={t.bookCall} />
    </div>
  </div>
</section>

<style>
  .process { padding-block: var(--space-2xl) 0; }
  h2 { margin-bottom: var(--space-xl); max-width: 12ch; }
  .process__steps { display: grid; gap: 0 var(--space-l); padding: 0; list-style: none; }
  li {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding-block: var(--space-m) var(--space-l);
    border-top: 1px solid var(--border);
  }
  /* Shoji-style serif figures. */
  .num { font-size: var(--step-3); line-height: 1; color: var(--gold); }
  li p { color: var(--text-muted); }
  .process__cta { margin-top: var(--space-l); }

  @media (min-width: 48em) {
    .process__steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 72em) {
    .process__steps { grid-template-columns: repeat(4, 1fr); }
    li { min-height: calc(var(--kumiko) * 4); }
  }
</style>
