---
import { site } from '../../site.config';
import BookCall from '../BookCall.astro';
import CopyEmail from '../CopyEmail.astro';
---

<section id="contact" class="contact band" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">
      <span class="line">Your pitch promised AI.</span>{' '}<span class="line line--indent">I make it real.</span>
    </h2>

    <ul class="contact__trust" role="list">
      <li>{site.availability}</li>
      <li>{site.replyPromise}</li>
      <li>{site.whiteLabel}</li>
    </ul>

    <div class="contact__paths">
      <div class="contact__path">
        <h3><span class="label tabular" aria-hidden="true">[01]</span> Ready to talk</h3>
        <p>Twenty minutes, no prep needed.</p>
        <BookCall variant="primary" />
      </div>
      <div class="contact__path contact__path--brief">
        <h3><span class="label tabular" aria-hidden="true">[02]</span> Have a brief</h3>
        <slot name="form"><p>Send it to the email below.</p></slot>
      </div>
      <div class="contact__path">
        <h3><span class="label tabular" aria-hidden="true">[03]</span> Just looking</h3>
        <CopyEmail />
        <a href={site.linkedin}>LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: var(--space-2xl); }
  h2 { font-size: var(--step-5); }
  h2 .line { display: block; }
  h2 .line--indent { padding-left: 2.2em; }
  .contact__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    margin-block: var(--space-l) var(--space-xl);
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .contact__trust li:first-child { color: var(--text); }
  .contact__paths { display: grid; gap: var(--space-xl) var(--space-l); }
  .contact__path {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    justify-items: start;
    border-top: 1px solid var(--text);
    padding-top: var(--space-m);
  }
  .contact__path h3 { display: flex; gap: var(--space-s); align-items: baseline; }
  .contact__path p { color: var(--text-muted); }

  @media (max-width: 47.99em) {
    h2 .line--indent { padding-left: 0; }
  }
  @media (min-width: 64em) {
    .contact__paths { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr); }
  }
</style>
