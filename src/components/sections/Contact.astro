---
import { site } from '../../site.config';
import BookCall from '../BookCall.astro';
import CopyEmail from '../CopyEmail.astro';
import SpineMark from '../SpineMark.astro';
import EdgePrint from '../EdgePrint.astro';
import { ui, langOf } from '../../i18n/ui';

const lang = langOf(Astro.currentLocale);
const t = ui[lang];
---

<section id="contact" class="contact band lattice-field spined" aria-labelledby="contact-title">
  <SpineMark section="contact" />
  <EdgePrint scene={7} label="Contact" meta="End of reel" />
  <div class="wrap">
    <h2 id="contact-title">
      {
        t.contact.titleLines.map((line, i) => (
          <>
            <span class:list={['line', { 'line--indent': i > 0 }]}>{line}</span>
            {i < t.contact.titleLines.length - 1 && lang !== 'ja' && ' '}
          </>
        ))
      }
    </h2>

    <ul class="contact__trust" role="list">
      <li><span class="contact__live" aria-hidden="true"></span>{t.contact.availability}</li>
      <li>{t.contact.reply}</li>
      <li>{t.contact.whiteLabel}</li>
    </ul>

    <div class="contact__paths">
      <div class="contact__path">
        <h3>{t.contact.talk}</h3>
        <p>{t.contact.talkNote}</p>
        <BookCall variant="primary" label={t.bookCall} />
      </div>
      <div class="contact__path contact__path--brief">
        <h3>{t.contact.brief}</h3>
        <slot name="form"><p>{t.contact.briefFallback}</p></slot>
      </div>
      <div class="contact__path">
        <h3>{t.contact.looking}</h3>
        <CopyEmail />
        <a href={site.linkedin}>LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: var(--space-2xl); }
  h2 { font-size: var(--step-5); }
  h2 .line { display: block; }
  h2 .line--indent { padding-left: 2.2em; }
  .contact__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    margin-block: var(--space-l) var(--space-xl);
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .contact__trust li:first-child { color: var(--text); display: inline-flex; align-items: center; gap: 0.5em; }
  /* Rust "live" diamond, as on Shoji's now line. */
  .contact__live { width: 7px; height: 7px; rotate: 45deg; background: var(--rust); }
  .contact__paths { display: grid; gap: var(--space-xl) var(--space-l); }
  .contact__path {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    justify-items: start;
    border-top: 1px solid var(--text);
    padding-top: var(--space-m);
  }
  .contact__path p { color: var(--text-muted); }

  @media (max-width: 47.99em) {
    h2 .line--indent { padding-left: 0; }
  }
  @media (min-width: 64em) {
    .contact__paths { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr); }
  }
</style>
