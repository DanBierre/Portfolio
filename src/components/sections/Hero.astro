---
import { Picture } from 'astro:assets';
import BookCall from '../BookCall.astro';
import poster from '../../assets/hero-poster.jpg';
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={poster}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 48em) 55vw, 100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="hero__poster"
    />
    <video class="hero__video" muted loop playsinline preload="none" poster={poster.src}>
      <source src="/media/hero.webm" type="video/webm" />
    </video>
  </div>

  <div class="wrap hero__copy">
    <h1 id="hero-title">
      <span class="line">The AI half of your</span>{' '}<span class="line">creative team.</span>
    </h1>
    <p class="hero__sub">
      Interactive AI experiences for your clients, and the generative pipelines that make your studio faster. Designed
      and built end to end.
    </p>
    <div class="hero__actions">
      <BookCall variant="primary" />
      <a class="btn btn--secondary" href="#work">See the work</a>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero__video');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.play().catch(() => {});
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: calc(100svh - 3.75rem);
    padding-block: var(--space-xl) var(--space-xl);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0 0 auto auto;
    z-index: -1;
    width: min(55%, 56rem);
    height: 78%;
  }
  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video { opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .hero__video.is-playing { opacity: 1; }
  /* Scrim: the media dissolves into the page where it meets the headline. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--bg) 0%, transparent 35%),
      linear-gradient(to top, var(--bg) 0%, transparent 45%);
  }

  .hero__copy { display: grid; gap: var(--space-l); }
  h1 { max-width: 14ch; }
  h1 .line { display: block; }
  .hero__sub { font-size: var(--step-1); color: var(--text-muted); max-width: 40ch; line-height: 1.45; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); }

  @media (max-width: 47.99em) {
    .hero { min-height: auto; padding-top: 0; }
    .hero__media {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      margin-bottom: calc(var(--space-xl) * -0.5);
    }
    .hero__media::after { background: linear-gradient(to top, var(--bg) 0%, transparent 40%); }
  }
</style>
