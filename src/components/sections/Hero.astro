---
import { Picture, getImage } from 'astro:assets';
import BookCall from '../BookCall.astro';
import portrait from '../../assets/portrait.jpg';
import SpineMark from '../SpineMark.astro';
import { ui, langOf } from '../../i18n/ui';

const lang = langOf(Astro.currentLocale);
const t = ui[lang];


// Indie edit source: Dan's Fushimi Inari photo as a texture; the still frame is the same photo, graded.
const texture = await getImage({ src: portrait, width: 800, format: 'jpg' });
---

<section id="hero" class="hero lattice-field spined" aria-labelledby="hero-title">
  <SpineMark section="hero" top="var(--space-l)" />
  <div class="wrap hero__grid">
    <figure class="hero__screen" aria-hidden="true">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 48em) 30vw, 60vw"
        alt=""
        loading="eager"
        class="hero__still"
        data-hero-still
      />
      <canvas class="hero__edit" data-hero-edit data-photo={texture.src} hidden></canvas>
      <span class="hero__kumiko lattice"></span>
      <span class="hero__divide"></span>
    </figure>

    <div class="hero__statement">
      <h1 id="hero-title" class="hero__title" aria-label={t.hero.title}>
        {
          t.hero.lines.map((line, i) => (
            <>
              <span class:list={['line', { 'line--indent': i > 0 }]} aria-hidden="true">
                {line.map((seg) => (seg.accent ? <span class="accent">{seg.text}</span> : seg.text))}
              </span>
              {i < t.hero.lines.length - 1 && lang !== 'ja' && ' '}
            </>
          ))
        }
      </h1>
      <p class="hero__note sep-list">{t.hero.offer.split(' · ').map((item) => <span class="sep-item">{item}</span>)}</p>
    </div>

    <div class="hero__actions">
      <BookCall variant="primary" label={t.bookCall} />
      <a class="btn btn--secondary" href="#work">{t.seeWork}</a>
      <p class="hero__live label"><span class="hero__now" aria-hidden="true"></span>{t.contact.availability}</p>
    </div>

    <button
      class="hero__toggle label"
      type="button"
      aria-label={t.hero.pause}
      data-pause={t.hero.pause}
      data-play={t.hero.play}
      hidden>
      <span class="when-playing" aria-hidden="true">pause</span><span class="when-paused" aria-hidden="true">play</span>
    </button>
  </div>

  <!-- The diffusion reveal: displacement noise that resolves to zero as the headline "develops". -->
  <svg class="hero__filters" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="develop" x="-10%" y="-20%" width="120%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="11" result="noise"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G"
      ></feDisplacementMap>
    </filter>
  </svg>
</section>

<script>
  import { createIndieEdit } from '../../lib/indie-renderer';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Diffusion reveal: the headline resolves out of noise, like an image generating through paper.
  const title = document.querySelector<HTMLElement>('.hero__title');
  const displace = document.querySelector('#develop feDisplacementMap');
  if (title && displace && !reduce) {
    const start = performance.now();
    const duration = 1600;
    title.classList.add('is-developing');
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 4);
      displace.setAttribute('scale', String(90 * (1 - eased)));
      if (t < 1) requestAnimationFrame(step);
      else title.classList.remove('is-developing');
    };
    requestAnimationFrame(step);
  }

  // Indie edit: a looping Gawx-style cut (speed ramps, motion blur, film burns) rendered in WebGL.
  // Only when motion is welcome and WebGL exists; otherwise the graded still stays. Always pausable (WCAG 2.2.2).
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-edit]');
  const still = document.querySelector<HTMLElement>('[data-hero-still]');
  const toggle = document.querySelector<HTMLButtonElement>('.hero__toggle');
  if (canvas && still && toggle && !reduce) {
    canvas.hidden = false;
    // Tests run in software-rendered Chromium; they opt in explicitly. Real visitors need a GPU.
    const allowSoftware = (window as any).__indieEditAllowSoftware === true;
    const edit = createIndieEdit(canvas, canvas.dataset.photo!, () => (still.hidden = true), { allowSoftware });
    if (!edit) {
      canvas.hidden = true;
    } else {
      let paused = false;
      const sync = () => {
        toggle.setAttribute('aria-label', paused ? toggle.dataset.play! : toggle.dataset.pause!);
        toggle.dataset.state = paused ? 'paused' : 'playing';
      };
      toggle.addEventListener('click', () => {
        paused = !paused;
        paused ? edit.stop() : edit.start();
        sync();
      });
      // Start once the page is idle (never competing with first load), and only run while on screen.
      const begin = () =>
        new IntersectionObserver(([e]) => (e.isIntersecting && !paused ? edit.start() : edit.stop())).observe(canvas);
      'requestIdleCallback' in window ? requestIdleCallback(begin, { timeout: 2000 }) : setTimeout(begin, 1200);
      toggle.hidden = false;
      sync();
    }
  }
</script>

<style>
  .hero { padding-block: var(--space-l); overflow: hidden; }
  .hero__filters { position: absolute; }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-m);
    row-gap: var(--space-l);
    min-height: calc(100svh - 3.75rem - var(--space-l) * 2);
    padding-top: calc(min(44svh, 34rem) + var(--space-m));
    align-content: end;
  }

  /* Screened footage: an off-centre portrait panel behind a kumiko lattice, in tall shoji proportion. */
  .hero__screen {
    position: absolute;
    top: 0;
    right: var(--gutter);
    height: min(44svh, 34rem);
    aspect-ratio: 1 / 1; /* two 1:2 shoji panels side by side */
    overflow: hidden;
    background: var(--surface);
  }
  .hero__divide { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; translate: -1px 0; background: rgb(20 20 20 / 0.85); }
  .hero__screen :global(.hero__still),
  .hero__edit { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* The still is graded like the edit: warm, crushed, a little faded. */
  .hero__screen :global(.hero__still) { filter: contrast(1.15) saturate(0.85) sepia(0.18) brightness(0.85); }
  .hero__edit { image-rendering: auto; }
  .hero__kumiko {
    position: absolute;
    inset: 0;
    background-position: 0 0, 0 0;
    --lattice: rgb(236 235 231 / 0.22);
    box-shadow: inset 0 0 0 1px rgb(236 235 231 / 0.22);
  }

  .hero__statement {
    --hero-size: clamp(2.8rem, 0.9rem + 6.4vw, 7.5rem);
    grid-column: 1 / -1; position: relative;
  }
  /* Japanese glyphs are full width: a smaller size keeps each line on one line. */
  .hero__statement:lang(ja) { --hero-size: clamp(2.2rem, 0.8rem + 5vw, 5.5rem); }
  .hero__title {
    font-size: var(--hero-size);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-weight: 430;
    text-wrap: initial;
  }
  .hero__title .line { display: block; }
  .hero__title .line--indent { padding-left: 2.6em; }
  .hero__title.is-developing { filter: url(#develop); }
  /* Japanese glyphs are full width: a smaller size keeps each line on one line. */
  .hero__title:lang(ja) { letter-spacing: 0; line-height: 1.1; font-weight: 600; }

  /* The note sits in the gap the indent leaves, as in a Kolkhoze statement. */
  .hero__note {
    position: absolute;
    left: 0;
    bottom: calc(var(--hero-size) * 0.12);
    width: calc(var(--hero-size) * 2.4);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .hero__actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); }
  /* Rust means "now": the live diamond, as on Shoji's now line. */
  .hero__live { display: inline-flex; align-items: center; gap: 0.6em; margin-left: var(--space-s); text-transform: none; }
  .hero__now { width: 8px; height: 8px; rotate: 45deg; background: var(--rust); flex: none; }

  .hero__toggle {
    position: absolute;
    top: 0;
    right: var(--gutter);
    z-index: 1;
    margin: var(--space-xs);
    padding: 0.3em 0.8em;
    background: rgb(20 20 20 / 0.7);
    color: #ecebe7; /* always light: it sits on the footage */
    border: 1px solid rgb(236 235 231 / 0.3);
    border-radius: 999px;
    cursor: pointer;
  }
  .hero__toggle:hover { border-color: var(--ink-light); }
  .hero__toggle .when-paused,
  .hero__toggle[data-state='paused'] .when-playing { display: none; }
  .hero__toggle[data-state='paused'] .when-paused { display: inline; }

  @media (max-width: 47.99em) {
    .hero__grid { min-height: auto; padding-top: 0; }
    .hero__screen { position: relative; top: auto; right: auto; grid-column: 1 / -1; justify-self: end; height: auto; width: 62%; }
    .hero__toggle { right: 0; }
    .hero__title .line--indent { padding-left: 0; }
    .hero__note { position: static; width: auto; margin-top: var(--space-m); font-size: var(--step-0); }
  }
</style>
