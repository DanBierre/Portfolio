---
import SpineMark from '../SpineMark.astro';
import { ui, langOf } from '../../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];
---

<section id="services" class="services band lattice-field spined" aria-labelledby="services-title">
  <SpineMark section="services" />
  <div class="wrap">
    <h2 id="services-title">{t.services.title}</h2>
    <p class="services__lede">{t.services.intro}</p>
    <div class="services__grid">
      {
        t.services.columns.map((c) => (
          <section class="services__col" aria-label={c.name}>
            <h3>{c.name}</h3>
            <p class="services__intro">{c.intro}</p>
            <ul role="list">
              {c.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services { margin-top: var(--space-2xl); padding-block: var(--space-2xl); }
  h2 { max-width: 14ch; }
  .services__lede { margin-block: var(--space-l) var(--space-xl); font-size: var(--step-1); line-height: 1.4; max-width: 44ch; }
  .services__grid { display: grid; gap: var(--space-xl) var(--space-xl); }
  .services__col { display: grid; gap: var(--space-s); align-content: start; }
  h3 { font-size: var(--step-3); font-weight: 440; letter-spacing: -0.045em; }
  .services__intro { color: var(--text-muted); margin-bottom: var(--space-s); }
  ul { padding: 0; list-style: none; border-top: 1px solid var(--text); }
  li { padding-block: var(--space-s); border-bottom: 1px solid var(--border); }

  @media (min-width: 48em) {
    .services__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
