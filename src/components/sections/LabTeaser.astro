---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

const all = (await getCollection('lab')).sort((a, b) => a.data.order - b.data.order);
const items = all.slice(0, 3);
---

<section id="lab" class="lab" aria-labelledby="lab-title">
  <div class="wrap">
    <div class="lab__head">
      <h2 id="lab-title">From the Lab<span class="count" aria-hidden="true">{all.length}</span></h2>
      <a class="label lab__all" href="/lab">See the Lab</a>
    </div>
    <div class="lab__grid">
      {
        items.map((item, i) => (
          <article class="lab__item">
            <Picture
              src={item.data.image}
              formats={['avif', 'webp']}
              widths={[480, 800]}
              sizes="(min-width: 48em) 30vw, 100vw"
              alt={item.data.imageAlt}
            />
            <div class="lab__caption">
              <h3>{item.data.title}</h3>
              <p class="label">
                {String(i + 1).padStart(2, '0')} / {item.data.interactive ? 'interactive' : 'study'}
              </p>
            </div>
            <p class="lab__summary">{item.data.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lab { padding-block: var(--space-2xl) 0; }
  .lab__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }
  .lab__all { color: var(--text); text-decoration: underline; }
  .lab__grid { display: grid; gap: var(--space-xl) var(--space-m); }
  .lab__item { display: grid; gap: var(--space-s); align-content: start; }
  .lab__item :global(img) {
    aspect-ratio: 1 / 2;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.5s var(--ease-out);
  }
  .lab__item:hover :global(img) { filter: none; }
  .lab__caption { display: flex; justify-content: space-between; gap: var(--space-s); align-items: baseline; }
  h3 { font-size: var(--step-0); font-weight: 500; letter-spacing: -0.01em; }
  .lab__summary { color: var(--text-muted); font-size: var(--step--1); }

  @media (min-width: 48em) {
    .lab__grid { grid-template-columns: repeat(3, minmax(0, 18rem)); justify-content: space-between; }
    .lab__item:nth-child(2) { margin-top: calc(var(--kumiko) * 2); }
  }
</style>
