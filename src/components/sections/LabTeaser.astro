---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SpineMark from '../SpineMark.astro';
import EdgePrint from '../EdgePrint.astro';
import { ui, langOf } from '../../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];
const all = (await getCollection('lab')).filter((e) => !e.data.hidden).sort((a, b) => a.data.order - b.data.order);
const items = all.slice(0, 3);
---

<section id="lab" class="lab spined" aria-labelledby="lab-title">
  <SpineMark section="lab" />
  <EdgePrint scene={6} label="Lab" meta="Reels 01–03" />
  <div class="wrap">
    <div class="lab__head">
      <h2 id="lab-title">{t.lab.title}<span class="count" aria-hidden="true">{all.length}</span></h2>
      <a class="label lab__all" href="/lab">{t.lab.all}</a>
    </div>
    <div class="lab__grid">
      {
        items.map((item, i) => (
          <article class="lab__item">
            <Picture
              src={item.data.image}
              formats={['avif', 'webp']}
              widths={[480, 800]}
              sizes="(min-width: 48em) 18rem, 100vw"
              alt={item.data.imageAlt}
            />
            <p class="reel-tape" aria-hidden="true"><span class="reel-can"></span>REEL {String(i + 1).padStart(2, '0')}</p>
            <div class="lab__caption">
              <h3>{item.data.title}</h3>
              <p class="label">
                <span class="num">{String(i + 1).padStart(2, '0')}</span> / {item.data.status === 'live' ? t.lab.live : t.lab.progress}
              </p>
            </div>
            <p class="lab__summary">{item.data.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lab { padding-block: var(--space-2xl) 0; }
  .lab__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }
  .lab__all { color: var(--text); text-decoration: underline; }
  .lab__grid { display: grid; gap: var(--space-xl) var(--space-m); }
  .lab__item { position: relative; display: grid; gap: var(--space-s); align-content: start; }
  /* Each piece as a labelled reel: covers sit in sepia like stored film and warm up on hover; a film
     can and a strip of cream tape carry the reel number. */
  .lab__item :global(img) {
    aspect-ratio: 1 / 2;
    object-fit: cover;
    filter: sepia(0.6) saturate(0.55) brightness(0.88);
    transition: filter 0.5s var(--ease-out);
  }
  .lab__item:hover :global(img) { filter: sepia(0.18) saturate(0.9) brightness(1); }
  .reel-tape {
    position: absolute;
    top: var(--space-s);
    left: calc(var(--space-s) * -0.5);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.3rem 0.6rem;
    background: var(--ink-light);
    color: var(--ground);
    font: 400 0.66rem var(--font-data);
    letter-spacing: 0.14em;
    rotate: -2deg;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.35);
  }
  .reel-can {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--ink-light) 0 18%, var(--ground) 19% 28%, #5a5248 29% 62%, var(--ground) 63%);
  }
  .lab__caption { display: flex; justify-content: space-between; gap: var(--space-s); align-items: baseline; }
  h3 { font-size: var(--step-0); font-weight: 500; letter-spacing: -0.01em; }
  .lab__summary { color: var(--text-muted); font-size: var(--step--1); }

  @media (min-width: 48em) {
    .lab__grid { grid-template-columns: repeat(3, minmax(0, 18rem)); justify-content: space-between; }
    .lab__item:nth-child(2) { margin-top: calc(var(--kumiko) * 2); }
  }
</style>
