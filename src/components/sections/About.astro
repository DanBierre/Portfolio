---
import { Picture } from 'astro:assets';
import { site } from '../../site.config';
import portrait from '../../assets/portrait.jpg';
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__text">
      <h2 id="about-title">About</h2>
      <p class="about__bio">{site.bio}</p>
      <p class="label about__tools">{site.tools}</p>
    </div>
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[480, 800]}
      sizes="(min-width: 48em) 25vw, 70vw"
      alt={`Portrait of ${site.name}`}
      class="about__photo"
    />
  </div>
</section>

<style>
  .about { padding-block: var(--space-2xl); }
  .about__grid { display: grid; gap: var(--space-l); align-items: end; }
  .about__grid :global(.about__photo) {
    width: min(70%, 22rem);
    justify-self: end;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    filter: grayscale(1);
  }
  .about__text { display: grid; gap: var(--space-m); }
  .about__bio { font-size: var(--step-2); line-height: 1.25; letter-spacing: -0.025em; text-indent: 3em; }
  .about__tools { text-transform: none; }

  @media (min-width: 48em) {
    .about__grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: var(--space-xl); }
  }
</style>
