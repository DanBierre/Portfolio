---
import { Picture } from 'astro:assets';
import SpineMark from '../SpineMark.astro';
import portrait from '../../assets/portrait.jpg';
import { brushRing } from '../../lib/enso';
import { ui, langOf } from '../../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];
const ring = brushRing({ r: 40, width: 9, seed: 2 });
---

<section id="about" class="about spined" aria-labelledby="about-title">
  <SpineMark section="about" />
  <div class="wrap about__grid">
    <div class="about__text">
      <h2 id="about-title">{t.about.title}</h2>
      <dl class="about__rows">
        {
          t.about.rows.map((r) => (
            <div>
              <dt>{r.term}</dt>
              <dd>{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <figure class="about__figure">
      <!-- Photo in a circle inside the brush ensō, as on the live site and in Shoji. -->
      <div class="portrait">
        <div class="portrait__pic">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[320, 640]}
            sizes="(min-width: 48em) 20rem, 70vw"
            alt={t.about.portraitAlt}
          />
        </div>
        <svg class="enso" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <filter id="ink" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="0.45" result="b"></feGaussianBlur>
            <feComponentTransfer in="b" result="bleed"><feFuncA type="linear" slope="0.5"></feFuncA></feComponentTransfer>
            <feMerge><feMergeNode in="bleed"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
          </filter>
          <path d={ring} fill="currentColor" filter="url(#ink)"></path>
        </svg>
      </div>
      <figcaption class="label">{t.about.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .about { padding-block: var(--space-2xl); }
  .about__grid { display: grid; gap: var(--space-xl); align-items: start; }
  .about__text { display: grid; gap: var(--space-l); }
  h2 { font-size: var(--step-4); max-width: 16ch; }
  .about__rows > div {
    display: grid;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m);
    border-top: 1px solid var(--border);
  }
  .about__rows > div:last-child { border-bottom: 1px solid var(--border); }
  dt { font-weight: 500; }
  dd { margin: 0; color: var(--text-muted); max-width: 52ch; }

  .about__figure { display: grid; gap: var(--space-s); justify-items: center; min-width: 0; }
  .portrait { position: relative; width: min(100%, 20rem); aspect-ratio: 1; }
  .portrait__pic { position: absolute; inset: 10%; border-radius: 50%; overflow: hidden; }
  /* Face centred in the circle (the photo is portrait, the face sits at ~45% height), whole hat
     and chin in frame. Graded like the hero: the torii orange calmed to the site's rust and gold. */
  .portrait__pic :global(picture) { display: block; height: 100%; }
  .portrait__pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: saturate(0.7) sepia(0.2) contrast(1.05) brightness(0.92);
  }
  /* Washi over the photo, as over the hero footage. */
  .portrait__pic::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/textures/washi.svg');
    mix-blend-mode: soft-light;
    opacity: 0.5;
  }
  .enso { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--rust); }

  /* The ensō brushes itself round as it scrolls in, one stroke, clockwise from the top. */
  @property --sweep { syntax: '<angle>'; inherits: false; initial-value: 360deg; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .enso {
        mask: conic-gradient(from -20deg, #000 var(--sweep), transparent 0);
        animation: brush linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      @keyframes brush { from { --sweep: 0deg; } }
    }
  }

  @media (min-width: 48em) {
    .about__grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: var(--space-xl); }
    .about__rows > div { grid-template-columns: 10rem minmax(0, 1fr); }
  }
</style>
