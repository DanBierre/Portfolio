---
import { getCollection } from 'astro:content';
import WorkCard from '../WorkCard.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title">Selected work</h2>
  </div>
  <div class="work__list">
    {work.map((entry) => <WorkCard entry={entry} />)}
  </div>
</section>

<style>
  .work { padding-block: var(--space-2xl) 0; }
  h2 { margin-bottom: var(--space-xl); }
  .work__list { display: grid; gap: var(--space-2xl); }
</style>
