---
import { getCollection } from 'astro:content';
import WorkCard from '../WorkCard.astro';
import SpineMark from '../SpineMark.astro';
import EdgePrint from '../EdgePrint.astro';
import { ui, langOf } from '../../i18n/ui';

const t = ui[langOf(Astro.currentLocale)];
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="work spined" aria-labelledby="work-title">
  <SpineMark section="work" />
  <EdgePrint scene={4} label="Work" meta="2 selects" />
  <div class="wrap">
    <div class="work__head">
      <h2 id="work-title">{t.work.title}<span class="count" aria-hidden="true">{work.length}</span></h2>
      <p class="label">{t.work.hint}</p>
    </div>
    <div class="work__index">
      {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </div>
</section>

<style>
  .work { padding-block: var(--space-2xl); }
  .work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-bottom: var(--space-xl);
  }
  @media not ((hover: hover) and (min-width: 80em)) {
    .work__head .label { display: none; }
  }
</style>
